<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - Mira's ST3S</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png">
    <meta name="theme-color" content="#FF0066">
    
    <link rel="stylesheet" href="/css/style.css">

    <style>
        body {
            background-color: var(--background-color);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .reset-card {
            width: 100%;
            max-width: 500px;
            background-color: var(--white);
            border-radius: var(--border-radius);
            border: none;
            overflow: hidden;
        }

        .brand-logo {
            width: 70px;
            height: 70px;
            border-radius: 18px;
            background-color: var(--white);
            padding: 5px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            margin-bottom: 1.5rem;
        }

        /* Password Toggle Styling */
        .input-group-password {
            position: relative;
        }
        .password-toggle-icon {
            position: absolute;
            top: 50%;
            right: 1rem;
            transform: translateY(-50%);
            cursor: pointer;
            z-index: 5;
            color: #6c757d;
            font-size: 1.2rem;
            transition: color 0.2s;
        }
        .password-toggle-icon:hover {
            color: var(--primary-color);
        }
        .form-floating > .form-control {
            padding-right: 3rem; /* Space for eye icon */
        }

        /* Validation List Styling */
        .password-criteria {
            list-style: none;
            padding: 1rem;
            margin-top: 1rem;
            background-color: #f8f9fa;
            border-radius: 8px;
            border: 1px solid #eee;
        }
        .password-criteria li {
            font-size: 0.85rem;
            color: #6c757d;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            transition: all 0.3s ease;
        }
        .password-criteria li:last-child {
            margin-bottom: 0;
        }
        .password-criteria li i {
            font-size: 1rem;
            margin-right: 0.75rem;
            transition: all 0.3s ease;
        }
        
        /* Valid State */
        .password-criteria li.valid {
            color: var(--success-dark);
            font-weight: 500;
        }
        .password-criteria li.valid i {
            color: var(--success-color);
        }
        
        /* Invalid State (Optional specific style) */
        .password-criteria li.invalid i {
            color: var(--danger-text);
        }
    </style>
</head>
<body>

    <div class="card reset-card shadow-lg">
        <div class="card-body p-4 p-md-5">
            <div class="text-center">
                <img src="/icons/favicon.png" alt="Logo" class="brand-logo">
                <h3 class="fw-bold mb-1">Reset Password</h3>
                <p class="text-muted small mb-4">Create a strong password for your account.</p>
            </div>

            <form action="/password/reset" method="POST" id="password-reset-form"> 
                <input type="hidden" id="contactNumber" name="contactNumber" value="<%= user.contactNumber %>">
                
                <%# Error Modal (Hidden, triggered by JS) %>
                <div class="modal fade" id="passwordCriteriaModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow">
                            <div class="modal-header border-0 pb-0">
                                <h5 class="modal-title text-danger fw-bold">
                                    <i class="bi bi-shield-exclamation me-2"></i>Requirement Error
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-center py-4">
                                <p class="text-muted mb-0">Please ensure your password meets all the security criteria below.</p>
                            </div>
                            <div class="modal-footer border-0 justify-content-center pt-0 pb-4">
                                <button type="button" class="btn btn-light fw-bold px-4" data-bs-dismiss="modal">Okay</button>
                            </div>
                        </div>
                    </div>
                </div>

                <%# Password Input %>
                <div class="mb-3 input-group-password">
                    <div class="form-floating">
                        <input type="password" class="form-control" id="password" name="password" placeholder="New Password" required minlength="8">
                        <label for="password">New Password</label>
                    </div>
                    <i class="bi bi-eye-slash password-toggle-icon" id="togglePassword"></i>
                </div>
                
                <%# Confirm Input %>
                <div class="mb-4 input-group-password">
                    <div class="form-floating">
                        <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Confirm Password" required minlength="8">
                        <label for="confirmPassword">Confirm Password</label>
                    </div>
                    <i class="bi bi-eye-slash password-toggle-icon" id="toggleConfirmPassword"></i>
                </div>

                <%# Criteria List %>
                <div class="password-criteria" id="criteriaList" style="display: none;">
                    <h6 class="fw-bold text-muted small text-uppercase mb-2">Password Requirements:</h6>
                    <ul class="list-unstyled mb-0">
                        <li id="length"><i class="bi bi-circle"></i> Min. 8 characters</li>
                        <li id="lowercase"><i class="bi bi-circle"></i> One lowercase letter</li>
                        <li id="uppercase"><i class="bi bi-circle"></i> One uppercase letter</li>
                        <li id="number"><i class="bi bi-circle"></i> One number</li>
                        <li id="special"><i class="bi bi-circle"></i> One special char (!@#$%)</li>
                        <li id="noContactMatch"><i class="bi bi-circle"></i> Not your phone number</li>
                        <li id="match" class="mt-2 pt-2 border-top"><i class="bi bi-circle"></i> Passwords match</li>
                    </ul>
                </div>
                
                <div class="d-grid mt-4 gap-3">
                    <button type="submit" id="submit-btn" class="btn btn-primary btn-lg fw-bold shadow-sm">Reset Password</button>
                    <a href="/" class="btn btn-outline-secondary fw-bold border-0">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {

            // --- 1. Password Visibility Toggler ---
            function setupPasswordToggle(inputId, toggleId) {
                const passwordInput = document.getElementById(inputId);
                const toggleIcon = document.getElementById(toggleId);

                if (passwordInput && toggleIcon) {
                    toggleIcon.addEventListener('click', function () {
                        const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                        passwordInput.setAttribute('type', type);
                        this.classList.toggle('bi-eye');
                        this.classList.toggle('bi-eye-slash');
                        this.classList.toggle('text-primary'); // Add color highlight when visible
                    });
                }
            }
            setupPasswordToggle('password', 'togglePassword');
            setupPasswordToggle('confirmPassword', 'toggleConfirmPassword');

            // --- 2. Element Setup ---
            const passwordInput = document.getElementById('password');
            const confirmPasswordInput = document.getElementById('confirmPassword');
            const contactNumberInput = document.getElementById('contactNumber');
            const criteriaList = document.getElementById('criteriaList');
            const applicationForm = document.getElementById('password-reset-form');
            const passwordCriteriaModalEl = document.getElementById('passwordCriteriaModal');
            const passwordCriteriaModal = passwordCriteriaModalEl ? new bootstrap.Modal(passwordCriteriaModalEl) : null;

            // Define criteria elements
            const criteria = {
                length: document.getElementById('length'),
                lowercase: document.getElementById('lowercase'),
                uppercase: document.getElementById('uppercase'),
                number: document.getElementById('number'),
                special: document.getElementById('special'),
                noContactMatch: document.getElementById('noContactMatch'),
                match: document.getElementById('match')
            };

            // Define validation checks
            const criteriaChecks = {
                length: (pw) => pw.length >= 8,
                lowercase: (pw) => /[a-z]/.test(pw),
                uppercase: (pw) => /[A-Z]/.test(pw),
                number: (pw) => /\d/.test(pw),
                special: (pw) => /[!@#$%^&*]/.test(pw),
                noContactMatch: (pw) => {
                    if (!contactNumberInput) return true;
                    const cleanedContact = contactNumberInput.value.replace(/[^0-9]/g, '');
                    const cleanedPassword = pw.replace(/[^0-9]/g, '');
                    // Only check if password actually contains digits to avoid false positives on empty string
                    if(cleanedPassword.length < 3) return true; 
                    return pw !== contactNumberInput.value && cleanedPassword !== cleanedContact;
                },
                match: (pw, confirmPw) => pw === confirmPw && pw.length > 0 
            };

            // --- 3. Validation Function ---
            function validatePassword() {
                if (!passwordInput || !criteriaList) return false;
                
                const password = passwordInput.value;
                const confirmPassword = confirmPasswordInput ? confirmPasswordInput.value : '';
                let allValid = true;

                // Show list if user starts typing
                if (password.length > 0) {
                    criteriaList.style.display = 'block';
                } else {
                    criteriaList.style.display = 'none';
                }

                for (const key in criteria) {
                    if (criteria[key]) {
                        const isValid = (key === 'match') 
                            ? criteriaChecks[key](password, confirmPassword) 
                            : criteriaChecks[key](password);

                        // Toggle Classes
                        criteria[key].classList.toggle('valid', isValid);
                        criteria[key].classList.toggle('invalid', !isValid && password.length > 0); // Only show invalid red if typed
                        
                        // Toggle Icons
                        const icon = criteria[key].querySelector('i');
                        if(isValid) {
                            icon.className = 'bi bi-check-circle-fill me-2';
                        } else {
                            icon.className = 'bi bi-circle me-2'; // Neutral circle until valid
                        }

                        if (!isValid) allValid = false;
                    }
                }
                return allValid;
            }

            // --- 4. Event Listeners ---
            if (passwordInput) passwordInput.addEventListener('input', validatePassword);
            
            if (confirmPasswordInput) {
                confirmPasswordInput.addEventListener('input', () => {
                    // Also re-run main validation to update 'match' status visually
                    validatePassword();
                });
            }

            if (applicationForm) {
                applicationForm.addEventListener('submit', (event) => {
                    if (!validatePassword()) {
                        event.preventDefault();
                        if (passwordCriteriaModal) passwordCriteriaModal.show();
                        passwordInput.focus();
                    }
                });
            }
        });
    </script>
</body>
</html>