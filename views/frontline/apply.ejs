<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Application - Mira's ST3S</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png">
    <meta name="theme-color" content="#FF0066">

    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* Specific styles for the application form page */
        body {
            background-color: var(--primary-color);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: calc(var(--vh, 1vh) * 100);
            padding: 1rem 0;
        }
        .application-container {
            width: 100%;
            max-width: 600px;
            background-color: var(--white);
            border-radius: var(--border-radius);
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
            overflow: hidden;
            margin: 1rem;
        }
        .application-header {
            background-color: var(--primary-light);
            padding: 1.5rem;
            display: flex;
            align-items: center;
        }
        .application-header .back-button {
            font-size: 1.5rem;
            color: var(--primary-color);
            margin-right: 1rem;
            text-decoration: none;
        }
        .application-header h1 {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
            color: var(--text-color);
        }
        .application-header p {
            margin-bottom: 0;
            color: #6c757d;
            font-size: 0.9rem;
        }
        .application-form-body {
            padding: 1.5rem;
        }
        @media (min-width: 576px) {
             .application-form-body { padding: 2rem; }
        }
        .form-section-title {
            font-weight: 600;
            margin-top: 1rem;
            margin-bottom: 1.5rem;
            color: var(--text-color);
            border-bottom: 1px solid #eee;
            padding-bottom: 0.5rem;
            font-size: 1.1rem;
        }
        .form-section-title:first-of-type { margin-top: 0; }
        .application-form-body .form-floating>.form-control,
        .application-form-body .form-floating>.form-select {
             height: calc(3.5rem + 2px);
             padding: 1rem 0.75rem;
        }
        .application-form-body .form-floating>label { padding: 1rem 0.75rem; }
        .application-form-body .form-floating>.form-select { padding-right: 2.5rem; }

        /* --- START: Revised Floating Label Fixes --- */

        /* General rule for floating labels when input has content or is focused */
        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label,
        .form-floating > .form-select:focus ~ label,
        .form-floating > .form-select:not([value=""]) ~ label /* Target select when value is not the initial empty one */
        {
            opacity: .65;
            transform: scale(.85) translateY(-.5rem) translateX(.15rem);
        }

        /* Ensure text/select content isn't obscured by label */
         .form-floating > .form-control:focus,
         .form-floating > .form-control:not(:placeholder-shown),
         .form-floating > .form-select:focus,
         .form-floating > .form-select:not([value=""]) /* Adjust padding when value is not empty */
         {
             padding-top: 1.625rem;
             padding-bottom: .625rem;
         }
         /* Apply padding fix initially for phone input if it has the default value */
         .form-floating > input#contactNumber[value="+63"] {
             padding-top: 1.625rem;
             padding-bottom: .625rem;
         }
          /* Apply label float initially for phone input if it has the default value */
         .form-floating > input#contactNumber[value="+63"] ~ label {
             opacity: .65;
             transform: scale(.85) translateY(-.5rem) translateX(.15rem);
         }
          /* Keep select padding consistent */
         .form-floating > .form-select {
             padding-top: 1.625rem !important; /* Force padding */
             padding-bottom: .625rem !important;
         }


        /* --- END: Revised Floating Label Fixes --- */


        .password-toggle-icon {
            position: absolute; right: 1rem; top: 50%;
            transform: translateY(-50%); cursor: pointer;
            color: #6c757d; z-index: 3;
        }
        .input-group-password { position: relative; }

        .form-control:focus, .form-select:focus {
             border-color: var(--primary-color);
             box-shadow: 0 0 0 0.2rem rgba(255, 0, 102, 0.2);
        }

        .application-footer {
            padding: 1.5rem; background-color: var(--light-gray);
            display: flex; justify-content: flex-end;
            gap: 1rem; border-top: 1px solid #eee;
        }
         @media (min-width: 576px) { .application-footer { padding: 1.5rem 2rem; } }
        .btn-cancel {
            background-color: #e9ecef; color: #6c757d; border: none;
            border-radius: var(--border-radius); padding: 0.75rem 1.5rem;
        }
        .btn-submit { border-radius: var(--border-radius); padding: 0.75rem 1.5rem; }

        .password-criteria { list-style: none; padding-left: 0; margin-top: 0.75rem; font-size: 0.85rem; }
        .password-criteria li { margin-bottom: 0.3rem; color: #6c757d; transition: color 0.2s ease-in-out; }
        .password-criteria li i { margin-right: 0.5rem; width: 1em; text-align: center; }
        .password-criteria li.valid { color: var(--success-dark); }
        .password-criteria li.invalid { color: var(--danger-text); }
        
        /* Confirmation Modal Styles */
        .confirmation-info-group {
            margin-bottom: 1.25rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #eee;
        }
        .confirmation-info-group:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }
        .confirmation-label {
            font-size: 0.85rem;
            color: #6c757d;
            margin-bottom: 0.25rem;
            font-weight: 500;
        }
        .confirmation-value {
            font-size: 1rem;
            color: var(--text-color);
            font-weight: 600;
        }
        .modal-header.bg-primary-custom {
            background-color: var(--primary-color) !important;
        }
    </style>
</head>
<body>

    <div class="application-container">
        <div class="application-header">
            <a href="/login" class="back-button"><i class="bi bi-arrow-left-circle-fill"></i></a>
            <div><h1>Staff Application</h1><p>Join the Mira's ST3S Team</p></div>
        </div>

        <% if (locals.errors && errors.length > 0) { %>
            <div class="alert alert-danger mb-0 rounded-0 border-0" role="alert">
                <h6 class="alert-heading fw-bold">Please fix the following errors:</h6>
                <ul class="mb-0 small ps-3">
                    <% errors.forEach(error => { %><li><%- error %></li><% }) %>
                </ul>
            </div>
        <% } %>

        <form action="/apply" method="POST" id="staff-application-form">
            <div class="application-form-body">

                <h2 class="form-section-title">Personal Information</h2>
                <div class="row mb-3 g-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="firstName" name="firstName" placeholder="First Name *" value="<%= locals.input ? input.firstName : '' %>" required>
                            <label for="firstName">First Name *</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="lastName" name="lastName" placeholder="Last Name *" value="<%= locals.input ? input.lastName : '' %>" required>
                            <label for="lastName">Last Name *</label>
                        </div>
                    </div>
                </div>
        
                <div class="mb-4">
                     <div class="form-floating">
                        <input type="tel" class="form-control" id="contactNumber" name="contactNumber" placeholder="+63XXXXXXXXXX *" pattern="^\+63\d{10}$" value="<%= locals.input && input.contactNumber ? input.contactNumber : '+63' %>" required>
                        <label for="contactNumber">Phone Number *</label>
                    </div>
                    <div class="form-text mt-1">This will be your login. Format: +63XXXXXXXXXX</div>
                </div>

                <h2 class="form-section-title">Account Security</h2>
                <div class="mb-3 input-group-password">
                    <div class="form-floating">
                        <input type="password" class="form-control" id="password" name="password" placeholder="Password *" required minlength="8" aria-describedby="passwordHelp criteriaList">
                        <label for="password">Password *</label>
                    </div>
                    <i class="bi bi-eye-slash password-toggle-icon" id="togglePassword"></i>
                    <ul class="password-criteria" id="criteriaList">
                        <li id="length"><i class="bi bi-x-circle"></i> Minimum 8 characters</li>
                        <li id="lowercase"><i class="bi bi-x-circle"></i> At least one lowercase letter</li>
                        <li id="uppercase"><i class="bi bi-x-circle"></i> At least one uppercase letter</li>
                        <li id="number"><i class="bi bi-x-circle"></i> At least one number</li>
                        <li id="special"><i class="bi bi-x-circle"></i> At least one special character (!@#$%^&*)</li>
                        <li id="match" class="mt-2"><i class="bi bi-x-circle"></i> Passwords match</li>
                    </ul>
                </div>
                
                <div class="mb-4 input-group-password">
                     <div class="form-floating">
                        <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Confirm Password *" required minlength="8" aria-describedby="criteriaList">
                        <label for="confirmPassword">Confirm Password *</label>
                    </div>
                     <i class="bi bi-eye-slash password-toggle-icon" id="toggleConfirmPassword"></i>
                </div>

                <h2 class="form-section-title">Position Details</h2>
                <div class="row g-3">
                    <div class="col-md-6 mb-3 mb-md-0">
                         <div class="form-floating">
                            <select class="form-select" id="positionApplied" name="positionApplied" required>
                                <option value="" selected disabled hidden>Select position *</option>
                                <option value="Front Liner" <%= (locals.input && input.positionApplied === 'Front Liner') ? 'selected' : '' %>>Cashier</option>
                                <option value="Cook" <%= (locals.input && input.positionApplied === 'Cook') ? 'selected' : '' %>>Cook</option>
                                <option value="Admin" <%= (locals.input && input.positionApplied === 'Admin') ? 'selected' : '' %>>Admin</option>
                            </select>
                            <label for="positionApplied">Position *</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                         <div class="form-floating">
                            <select class="form-select" id="preferredBranch" name="preferredBranch" required>
                                <option value="" selected disabled hidden>Select branch *</option>
                                <% if (branches && branches.length > 0) { %>
                                    <% branches.forEach(branch => { %>
                                        <option value="<%= branch._id %>" <%= (locals.input && input.preferredBranch == branch._id) ? 'selected' : '' %>>
                                            <%= branch.name %>
                                        </option>
                                    <% }) %>
                                <% } else { %>
                                    <option disabled>No branches available</option>
                                <% } %>
                            </select>
                            <label for="preferredBranch">Preferred Branch *</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="application-footer">
                <button type="button" class="btn btn-cancel fw-bold" id="cancelBtn">Cancel</button>
                <button type="submit" class="btn btn-primary btn-submit fw-bold">Submit Application</button>
            </div>
        </form>

    </div>

    <%# Password Criteria Error Modal %>
    <div class="modal fade" id="passwordCriteriaModal" tabindex="-1" aria-labelledby="passwordCriteriaModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
          <div class="modal-header border-0"><h5 class="modal-title text-danger" id="passwordCriteriaModalLabel"><i class="bi bi-exclamation-triangle-fill me-2"></i>Password Requirements Not Met</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
          <div class="modal-body">Please ensure your password meets all the specified criteria and that both password fields match before submitting.</div>
          <div class="modal-footer border-0"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button></div>
      </div></div>
    </div>

    <%# Confirmation Modal %>
    <div class="modal fade" id="confirmationModal" tabindex="-1" aria-labelledby="confirmationModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header bg-primary-custom text-white border-0">
            <h5 class="modal-title" id="confirmationModalLabel">
              <i class="bi bi-check-circle-fill me-2"></i>Confirm Your Information
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body p-4">
            <p class="mb-3 text-muted">Please verify that all information is accurate before submitting:</p>
            
            <div class="confirmation-info-group">
              <div class="confirmation-label">Full Name</div>
              <div class="confirmation-value" id="confirmFullName">-</div>
            </div>
            
            <div class="confirmation-info-group">
              <div class="confirmation-label">Phone Number</div>
              <div class="confirmation-value" id="confirmPhone">-</div>
            </div>
            
            <div class="confirmation-info-group">
              <div class="confirmation-label">Position Applied</div>
              <div class="confirmation-value" id="confirmPosition">-</div>
            </div>
            
            <div class="confirmation-info-group">
              <div class="confirmation-label">Preferred Branch</div>
              <div class="confirmation-value" id="confirmBranch">-</div>
            </div>

            <div class="alert alert-info mt-3 mb-0" role="alert">
              <i class="bi bi-info-circle-fill me-2"></i>
              <small>Your application will be reviewed by our team. Please ensure all details are correct.</small>
            </div>
          </div>
          <div class="modal-footer border-0">
            <button type="button" class="btn btn-cancel fw-bold" data-bs-dismiss="modal">
              <i class="bi bi-pencil-fill me-1"></i>Edit Information
            </button>
            <button type="button" class="btn btn-primary fw-bold" id="confirmSubmitBtn">
              <i class="bi bi-send-fill me-1"></i>Confirm & Submit
            </button>
          </div>
        </div>
      </div>
    </div>

    <%# Cancel Warning Modal %>
    <div class="modal fade" id="cancelWarningModal" tabindex="-1" aria-labelledby="cancelWarningModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header bg-danger text-white border-0">
            <h5 class="modal-title" id="cancelWarningModalLabel">
              <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Cancellation
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body p-4">
            <p class="mb-3">Are you sure you want to cancel your application?</p>
            
            <div class="alert alert-danger mb-0" role="alert">
              <i class="bi bi-exclamation-circle-fill me-2"></i>
              <strong>Warning:</strong> All the information you've entered will be lost and cannot be recovered.
            </div>
          </div>
          <div class="modal-footer border-0">
            <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">
              <i class="bi bi-arrow-left me-1"></i>Continue Editing
            </button>
            <button type="button" class="btn btn-danger fw-bold" id="confirmCancelBtn">
              <i class="bi bi-x-circle me-1"></i>Yes, Cancel Application
            </button>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            function setupPasswordToggle(inputId, toggleId) {
                const passwordInput = document.getElementById(inputId);
                const toggleIcon = document.getElementById(toggleId);
                if (passwordInput && toggleIcon) {
                    toggleIcon.addEventListener('click', function () {
                        const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                        passwordInput.setAttribute('type', type);
                        this.classList.toggle('bi-eye');
                        this.classList.toggle('bi-eye-slash');
                    });
                }
            }
            setupPasswordToggle('password', 'togglePassword');
            setupPasswordToggle('confirmPassword', 'toggleConfirmPassword');

            const phoneInput = document.getElementById('contactNumber');
            if (phoneInput) {
                if (phoneInput.value === '' || !phoneInput.value.startsWith('+63')) {
                    phoneInput.value = '+63';
                }
                phoneInput.addEventListener('input', (e) => {
                    let value = e.target.value;
                    if (!value.startsWith('+63')) {
                        value = '+63';
                    }
                    value = '+63' + value.substring(3).replace(/[^\d]/g, '');
                    if (value.length > 13) {
                        value = value.substring(0, 13);
                    }
                    e.target.value = value;
                });
                phoneInput.addEventListener('keydown', (e) => {
                    const start = e.target.selectionStart;
                    const end = e.target.selectionEnd;
                    if ((e.key === 'Backspace' && start <= 3) || (e.key === 'Delete' && start < 3)) {
                        if (start === end || end <= 3) {
                            e.preventDefault();
                        }
                    }
                });
            }

            const setViewportHeight = () => {
                const vh = window.innerHeight * 0.01;
                document.documentElement.style.setProperty('--vh', `${vh}px`);
            };
            setViewportHeight();
            window.addEventListener('resize', setViewportHeight);

            const passwordInput = document.getElementById('password');
            const confirmPasswordInput = document.getElementById('confirmPassword');
            const criteria = {
                length: document.getElementById('length'),
                lowercase: document.getElementById('lowercase'),
                uppercase: document.getElementById('uppercase'),
                number: document.getElementById('number'),
                special: document.getElementById('special'),
                match: document.getElementById('match')
            };
            const criteriaList = document.getElementById('criteriaList');
            const passwordCriteriaModalEl = document.getElementById('passwordCriteriaModal');
            const passwordCriteriaModal = passwordCriteriaModalEl ? new bootstrap.Modal(passwordCriteriaModalEl) : null;
            const applicationForm = document.getElementById('staff-application-form');
            const criteriaChecks = {
                length: (pw) => pw.length >= 8,
                lowercase: (pw) => /[a-z]/.test(pw),
                uppercase: (pw) => /[A-Z]/.test(pw),
                number: (pw) => /\d/.test(pw),
                special: (pw) => /[@$!%*?&]/.test(pw),
                match: (pw, confirmPw) => pw === confirmPw && pw.length > 0
            };
            if (criteriaList) criteriaList.style.display = 'none';
            
            function validatePassword() {
                if (!passwordInput || !criteriaList) return false;
                const password = passwordInput.value;
                const confirmPassword = confirmPasswordInput ? confirmPasswordInput.value : '';
                let allValid = true;
                criteriaList.style.display = password.length > 0 ? 'block' : 'none';
                for (const key in criteria) {
                    if (criteria[key]) {
                        const isValid = criteriaChecks[key](password, confirmPassword);
                        criteria[key].classList.toggle('valid', isValid);
                        criteria[key].classList.remove('invalid');
                        criteria[key].querySelector('i').className = isValid ? 'bi bi-check-circle-fill' : 'bi bi-x-circle';
                        if (!isValid) {
                            allValid = false;
                        }
                    }
                }
                return allValid;
            }
            
            if (passwordInput) {
                passwordInput.addEventListener('input', validatePassword);
            }
            if (confirmPasswordInput) {
                confirmPasswordInput.addEventListener('input', () => {
                    const password = passwordInput.value;
                    const confirmPassword = confirmPasswordInput.value;
                    const isMatchValid = criteriaChecks.match(password, confirmPassword);
                    if (criteria.match) {
                        criteria.match.classList.toggle('valid', isMatchValid);
                        criteria.match.querySelector('i').className = isMatchValid ? 'bi bi-check-circle-fill' : 'bi bi-x-circle';
                        if(password.length > 0) validatePassword();
                    }
                });
            }

            // Confirmation Modal Logic
            const confirmationModalEl = document.getElementById('confirmationModal');
            const confirmationModal = confirmationModalEl ? new bootstrap.Modal(confirmationModalEl) : null;
            const confirmSubmitBtn = document.getElementById('confirmSubmitBtn');
            let allowFormSubmit = false;

            if (applicationForm) {
                applicationForm.addEventListener('submit', (event) => {
                    // Prevent default submission
                    event.preventDefault();
                    
                    const isPasswordValid = validatePassword();
                    if (!isPasswordValid) {
                        if (passwordCriteriaModal) {
                            passwordCriteriaModal.show();
                        } else {
                            alert('Password does not meet all criteria or passwords do not match.');
                        }
                        passwordInput.focus();
                        passwordInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }

                    // If form is already approved to submit, let it go through
                    if (allowFormSubmit) {
                        applicationForm.submit();
                        return;
                    }

                    // Show confirmation modal with user data
                    const firstName = document.getElementById('firstName').value;
                    const lastName = document.getElementById('lastName').value;
                    const phone = document.getElementById('contactNumber').value;
                    const position = document.getElementById('positionApplied').value;
                    const branchSelect = document.getElementById('preferredBranch');
                    const branchText = branchSelect.options[branchSelect.selectedIndex].text;

                    document.getElementById('confirmFullName').textContent = `${firstName} ${lastName}`;
                    document.getElementById('confirmPhone').textContent = phone;
                    document.getElementById('confirmPosition').textContent = position;
                    document.getElementById('confirmBranch').textContent = branchText;

                    if (confirmationModal) {
                        confirmationModal.show();
                    }
                });
            }

            // Handle confirmation submit
            if (confirmSubmitBtn) {
                confirmSubmitBtn.addEventListener('click', () => {
                    allowFormSubmit = true;
                    if (confirmationModal) {
                        confirmationModal.hide();
                    }
                    // Submit the form
                    applicationForm.submit();
                });
            }

            // Cancel Warning Modal Logic
            const cancelWarningModalEl = document.getElementById('cancelWarningModal');
            const cancelWarningModal = cancelWarningModalEl ? new bootstrap.Modal(cancelWarningModalEl) : null;
            const cancelBtn = document.getElementById('cancelBtn');
            const confirmCancelBtn = document.getElementById('confirmCancelBtn');

            // Handle cancel button click
            if (cancelBtn) {
                cancelBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    
                    // Show cancel warning modal
                    if (cancelWarningModal) {
                        cancelWarningModal.show();
                    }
                });
            }

            // Handle confirm cancel button click
            if (confirmCancelBtn) {
                confirmCancelBtn.addEventListener('click', () => {
                    // Redirect to login page
                    window.location.href = '/login';
                });
            }
        });
    </script>
</body>
</html>