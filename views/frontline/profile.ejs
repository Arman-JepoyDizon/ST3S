<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile - Mira's ST3S</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png">
    <meta name="theme-color" content="#FF0066">
    
    <link rel="stylesheet" href="/css/style.css">

    <style>
        .profile-container {
            max-width: 600px;
            margin: 0 auto;
            padding: 1rem;
            min-height: 100vh;
            padding-bottom: 80px; /* Space for bottom nav */
        }

        .profile-header {
            text-align: center;
            margin-bottom: 2rem;
            padding: 2rem 1rem;
            background-color: var(--white);
            border-radius: var(--border-radius);
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        .profile-avatar-lg {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, var(--primary-color), var(--primary-darker));
            color: var(--white);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0 auto 1rem auto;
            box-shadow: 0 4px 10px rgba(255, 0, 102, 0.3);
        }

        .profile-form-card {
            background-color: var(--white);
            border-radius: var(--border-radius);
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }

        /* Input styling to look like plain text when readonly */
        .form-control:read-only {
            background-color: #f8f9fa;
            border-color: transparent;
            color: var(--text-color);
        }
        
        .form-control:read-only:focus {
            box-shadow: none;
        }

        /* Editing State */
        .is-editing .form-control {
            background-color: var(--white);
            border-color: #dee2e6;
        }

        .badge-role {
            padding: 0.5em 1em;
            font-size: 0.85rem;
            border-radius: 50px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
    </style>
</head>
<body class="bg-light">

    <%# Back Button Header %>
    <div class="container-fluid p-3 d-flex align-items-center">
        <a href="/" class="text-dark fs-4 me-3"><i class="bi bi-arrow-left"></i></a>
        <h5 class="mb-0 fw-bold">Profile Settings</h5>
    </div>

    <main class="profile-container pt-0">
        
        <%# Profile Header with Avatar %>
        <div class="profile-header">
            <div class="profile-avatar-lg">
                <%= user.firstName.charAt(0).toUpperCase() %><%= user.lastName.charAt(0).toUpperCase() %>
            </div>
            <h4 class="fw-bold mb-1"><%= user.firstName %> <%= user.lastName %></h4>
            <span class="badge badge-role badge-<%= user.role.toLowerCase().replace(/\s+/g, '-') %>">
                <%= user.role.toLowerCase() === 'front liner' ? 'CASHIER' : user.role %>
            </span>
        </div>

        <% if(message){ %>
            <div class="alert alert-<%= messageType == 'success'? 'success' : 'danger' %> border-0 shadow-sm mb-4" role="alert">
                <i class="bi <%= messageType == 'success'? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill' %> me-2"></i>
                <%= message %>
            </div>
        <% } %>

        <form action="/profile/update" method="POST" id="profile-form">
            <input type="hidden" name="id" value="<%= user._id %>">
            
            <div class="profile-form-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-muted text-uppercase small mb-0">Personal Information</h6>
                    <button type="button" id="edit-toggle-btn" class="btn btn-sm btn-light text-primary fw-bold">
                        <i class="bi bi-pencil-square me-1"></i>Edit
                    </button>
                </div>

                <div class="row g-3">
                    <div class="col-12">
                        <div class="form-floating">
                            <input type="text" class="form-control edit-field" id="firstName" name="firstName" placeholder="First Name" value="<%= user.firstName %>" readonly required>
                            <label for="firstName">First Name</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-floating">
                            <input type="text" class="form-control edit-field" id="lastName" name="lastName" placeholder="Last Name" value="<%= user.lastName %>" readonly required>
                            <label for="lastName">Last Name</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="contactNumber" value="<%= user.contactNumber %>" readonly disabled>
                            <label for="contactNumber">Phone Number (Login ID)</label>
                            <div class="form-text text-end"><i class="bi bi-lock-fill me-1"></i>Cannot be changed</div>
                        </div>
                    </div>
                </div>

                <%# Action Buttons (Hidden by default) %>
                <div id="edit-actions" class="mt-4 d-none">
                    <div class="d-grid gap-2 d-flex">
                        <button type="button" id="cancel-btn" class="btn btn-light flex-grow-1 fw-bold">Cancel</button>
                        <button type="submit" class="btn btn-success flex-grow-1 fw-bold">Save Changes</button>
                    </div>
                </div>
            </div>
        </form>

        <%# Security & Logout Section %>
        <div class="profile-form-card">
            <h6 class="fw-bold text-muted text-uppercase small mb-3">Security</h6>
            <div class="d-grid gap-2">
                <a href="/password/reset" class="btn btn-outline-secondary d-flex justify-content-between align-items-center p-3 border-0 bg-light">
                    <span><i class="bi bi-shield-lock me-2"></i>Change Password</span>
                    <i class="bi bi-chevron-right small"></i>
                </a>
                <button type="button" class="btn btn-outline-danger d-flex justify-content-between align-items-center p-3 border-0 bg-light text-danger mt-2" data-bs-toggle="modal" data-bs-target="#logoutConfirmModal">
                    <span><i class="bi bi-box-arrow-right me-2"></i>Logout</span>
                    <i class="bi bi-chevron-right small"></i>
                </button>
            </div>
        </div>

    </main>

    <%# Logout Modal %>
    <div class="modal fade" id="logoutConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-body text-center p-4">
                    <h5 class="mb-3 fw-bold">Logging Out</h5>
                    <p class="text-muted small mb-3">You will be redirected to the login screen automatically.</p>
                    
                    <div class="progress mb-4" role="progressbar" style="height: 6px">
                        <div class="progress-bar bg-primary" id="logout-progress-bar" style="width: 100%"></div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">Cancel</button>
                        <a href="/logout" class="btn btn-primary fw-bold">Logout Now</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%# Badges CSS %>
    <style>
        .badge-admin { background-color: var(--admin-bg); color: var(--admin-text); }
        .badge-front-liner { background-color: var(--frontliner-bg); color: var(--frontliner-text); }
        .badge-cook { background-color: var(--cook-bg); color: var(--cook-text); }
        .badge-assistant-manager { background-color: #6E6E6E; color: white; }
        .badge-super-admin { background-color: #333; color: white; }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('profile-form');
            const editBtn = document.getElementById('edit-toggle-btn');
            const cancelBtn = document.getElementById('cancel-btn');
            const actionsDiv = document.getElementById('edit-actions');
            const inputs = document.querySelectorAll('.edit-field');
            const container = document.querySelector('.profile-form-card');

            // Store original values to revert on cancel
            let originalValues = {};

            editBtn.addEventListener('click', () => {
                // Save current values
                inputs.forEach(input => {
                    originalValues[input.id] = input.value;
                    input.removeAttribute('readonly');
                });
                
                // Toggle UI
                editBtn.classList.add('d-none');
                actionsDiv.classList.remove('d-none');
                container.classList.add('is-editing');
                
                // Focus first input
                if(inputs.length > 0) inputs[0].focus();
            });

            cancelBtn.addEventListener('click', () => {
                // Revert values
                inputs.forEach(input => {
                    input.value = originalValues[input.id] || '';
                    input.setAttribute('readonly', 'true');
                });

                // Toggle UI
                actionsDiv.classList.add('d-none');
                editBtn.classList.remove('d-none');
                container.classList.remove('is-editing');
            });

            // Logout Timer Logic
            const logoutModal = document.getElementById('logoutConfirmModal');
            if(logoutModal) {
                const progressBar = document.getElementById('logout-progress-bar');
                let timer, interval;
                
                logoutModal.addEventListener('show.bs.modal', () => {
                    let width = 100;
                    progressBar.style.width = '100%';
                    
                    // 5 second timer
                    timer = setTimeout(() => { window.location.href = '/logout'; }, 5000);
                    
                    interval = setInterval(() => {
                        width -= 2; // Reduce by 2% every 100ms (100ms * 50 steps = 5000ms)
                        progressBar.style.width = width + '%';
                    }, 100);
                });

                logoutModal.addEventListener('hide.bs.modal', () => {
                    clearTimeout(timer);
                    clearInterval(interval);
                });
            }
        });
    </script>
</body>
</html>