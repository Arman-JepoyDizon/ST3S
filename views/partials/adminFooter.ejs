<div class="modal fade" id="adminLogoutConfirmModal" tabindex="-1" aria-labelledby="adminLogoutModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center p-4">
                <h5 class="mb-3" id="adminLogoutModalLabel">Do you wish to logout?</h5>
                <p class="text-muted small">You will be logged out automatically.</p>
                
                <div class="progress" role="progressbar" aria-label="Logout countdown" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" style="height: 10px">
                    <div class="progress-bar bg-primary" id="admin-logout-progress-bar" style="width: 100%"></div>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <a href="/logout" class="btn btn-primary">Logout Now</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="orderDetailsModal" tabindex="-1" aria-labelledby="orderDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header d-block text-center border-0 pt-4 pb-0">
                <div class="receipt-icon-wrapper mx-auto mb-2">
                    <i class="bi bi-receipt fs-3 text-white"></i>
                </div>
                <h5 class="modal-title fw-bold fs-5 mb-0" id="orderDetailsModalLabel">Order Receipt</h5>
                <p class="text-muted mb-0" id="modal-order-timestamp"></p>
                <button type="button" class="btn-close position-absolute top-0 end-0 mt-3 me-3" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <div class="bg-light p-3 rounded-3 mb-3">
                    <small class="text-muted d-block">Order Number</small>
                    <strong class="fs-6" id="modal-order-id">ORD-XXXXXXXXXX</strong>
                </div>

                <h6 class="fw-bold mb-3">Items</h6>
                <div id="modal-items-list" class="mb-4">
                    </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0">Total</h5>
                    <h5 class="fw-bold text-primary mb-0 fs-4" id="modal-total-amount">₱0.00</h5>
                </div>

                <div class="d-grid gap-2 mb-3">
                    <button type="button" class="btn btn-primary fw-bold btn-lg" id="modal-change-status-btn"></button>
                </div>
                <div class="d-grid">
                    <button type="button" class="btn btn-outline-secondary fw-bold" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/main.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const orderDetailsModalElement = document.getElementById('orderDetailsModal');
    if (orderDetailsModalElement) {
        const orderDetailsModal = new bootstrap.Modal(orderDetailsModalElement);
        const viewButtons = document.querySelectorAll('.transaction-list-desktop .view-order-btn');

        // Modal elements
        const modalOrderTimestamp = document.getElementById('modal-order-timestamp');
        const modalOrderId = document.getElementById('modal-order-id');
        const modalItemsList = document.getElementById('modal-items-list');
        const modalTotalAmount = document.getElementById('modal-total-amount');
        const modalChangeStatusBtn = document.getElementById('modal-change-status-btn');

        viewButtons.forEach(button => {
            button.addEventListener('click', async (event) => {
                const transactionJson = event.currentTarget.dataset.transaction;
                if (!transactionJson) return;

                const transaction = JSON.parse(transactionJson);

                // Populate modal content
                const createdAtDate = new Date(transaction.createdAt);
                modalOrderTimestamp.textContent = createdAtDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) + ' ' + createdAtDate.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
                modalOrderId.textContent = `ORD-${transaction._id.toString().slice(-10).toUpperCase()}`;
                modalTotalAmount.textContent = `₱${transaction.totalAmount.toFixed(2)}`;

                // Populate Items List
                modalItemsList.innerHTML = ''; // Clear previous items
                transaction.items.forEach(item => {
                    const itemRow = document.createElement('div');
                    itemRow.className = 'modal-item-row';
                    
                    let itemNameDisplay = item.productId ? item.productId.name : 'Product Not Found';
                    if (item.sizeLabel) {
                        itemNameDisplay += ` <small class="text-muted">(${item.sizeLabel})</small>`;
                    }

                    // --- THIS IS THE UPDATED LINE ---
                    itemRow.innerHTML = `
                        <span class="modal-item-name"><span class="fw-bold me-2">${item.quantity}x</span> ${itemNameDisplay}</span>
                        <span class="modal-item-price">₱${(item.price * item.quantity).toFixed(2)}</span>
                    `;
                    // --- END OF UPDATE ---
                    
                    modalItemsList.appendChild(itemRow);
                });

                // Handle the dynamic status change button
                modalChangeStatusBtn.onclick = null; // Clear previous event listeners

                if (transaction.status === 'Pending') {
                    modalChangeStatusBtn.textContent = 'Mark as Ready';
                    modalChangeStatusBtn.classList.remove('btn-success', 'btn-danger');
                    modalChangeStatusBtn.classList.add('btn-primary');
                    modalChangeStatusBtn.dataset.nextStatus = 'Ready';
                    modalChangeStatusBtn.style.display = 'block';
                } else if (transaction.status === 'Ready') {
                    modalChangeStatusBtn.textContent = 'Mark as Completed';
                    modalChangeStatusBtn.classList.remove('btn-primary', 'btn-danger');
                    modalChangeStatusBtn.classList.add('btn-success');
                    modalChangeStatusBtn.dataset.nextStatus = 'Completed';
                    modalChangeStatusBtn.style.display = 'block';
                } else {
                    modalChangeStatusBtn.style.display = 'none';
                }

                if (modalChangeStatusBtn.style.display !== 'none') {
                    modalChangeStatusBtn.addEventListener('click', async () => {
                        const nextStatus = modalChangeStatusBtn.dataset.nextStatus;
                        if (!nextStatus) return;

                        try {
                            const response = await fetch(`/admin/orders/${transaction._id}/status`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({ status: nextStatus })
                            });

                            if (response.ok) {
                                window.location.reload(); 
                            } else {
                                const errorData = await response.json();
                                alert('Failed to update order status: ' + (errorData.message || 'Unknown error'));
                            }
                        } catch (error) {
                            console.error('Error updating order status:', error);
                            alert('An error occurred while updating the order status.');
                        }
                    });
                }
                
                orderDetailsModal.show();
            });
        });
    }
});
</script>
</body>
</html>