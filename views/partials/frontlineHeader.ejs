<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mira's Menu - ST3S</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png">
    <meta name="theme-color" content="#FF0066">
    
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="frontline-body">

    <div id="audio-enable-banner" class="audio-banner">
        <p>Enable sound for notifications?</p>
        <button id="enable-audio-btn" class="btn btn-sm btn-light">Enable</button>
    </div>

    <header class="frontline-header">
        <div class="header-top-row">
            <div class="d-flex align-items-center">
                <img src="/icons/favicon.png" alt="Mira's ST3S Logo" style="height: 36px; width: 36px;" class="me-2">
                <h1 class="h4 mb-0 fw-bold">Mira's Menu</h1>
            </div>
            
            <div class="cart-icon-wrapper">
                <div class="cart-link-wrapper">
                    <a href="/cart" class="text-white">
                        <i class="bi bi-cart3 fs-4"></i>
                        <span class="badge rounded-pill bg-white text-dark cart-count">0</span>
                    </a>
                </div>
                <a href="/sales" class="nav-link <%= (activePage === 'sales') ? 'active' : '' %>">
                    <i class="bi bi-cash-coin"></i>
                    <span>Sales</span>
                    <% if (locals.readyOrdersCount && readyOrdersCount > 0) { %>
                        <span class="badge rounded-pill bg-danger nav-badge"><%= readyOrdersCount %></span>
                    <% } %>
                </a>
                <a href="/profile/<%= user.id%>" class="text-white">
                    <i class="bi bi-person-circle fs-4"></i>
                </a>
            </div>
        </div>
   
        <p class="header-greeting">What would you like to order?</p>

        <div class="search-bar-wrapper">
            <i class="bi bi-search search-bar-icon"></i>
            <input type="search" class="form-control search-bar" id="searchMenu" placeholder="Search delicious food...">
        </div>
    </header>
