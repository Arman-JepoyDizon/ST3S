<%- include('../partials/adminHeader') %>
<%- include('../partials/adminDesktopNav', { activePage: 'users' }) %>

<%# --- MOBILE VIEW --- %>
<div class="d-lg-none">
    <div class="admin-container">
        <div class="admin-content">
            <%- include('../partials/adminNavbar') %>
            <main class="p-3">
                <div class="page-header mb-3">
                    <h2 class="h3 mb-0">Users</h2>
                    <%# Filter out Super Admins for the count (though controller already does) %>
                    <% const nonSuperAdminUsersMobile = users.filter(user => user.role !== 'Super Admin'); %>
                    <% if (users && users.length > 0) { %>
                        <p class="text-muted"><%= nonSuperAdminUsersMobile.length %> team members</p>
                    <% } %>
                </div>
                <a href="/admin/users/add" class="btn btn-primary btn-lg w-100 mb-3 fw-bold">
                    <i class="bi bi-plus-lg me-1"></i>Add User
                </a>
                <div class="form-floating mb-4">
                    <input type="search" class="form-control" id="searchUsersMobile" placeholder="Search users...">
                    <label for="searchUsersMobile"><i class="bi bi-search me-2"></i>Search users...</label>
                </div>
                <div class="user-list-mobile">
                    <% if (users && users.length > 0) { %>
                        <% let displayedUsersMobile = 0; %> <%# Counter for displayed users %>
                        <% users.forEach(user => { %>
                            <%# Added: Explicit check to skip Super Admin role %>
                            <% if (user.role !== 'Super Admin') { %>
                                <% displayedUsersMobile++; %>
                                <a href="/admin/users/edit/<%= user._id %>" class="user-card-link">
                                    <div class="card user-card-revamp mb-3">
                                        <div class="card-body d-flex align-items-center">
                                            <div class="user-avatar-initial me-3">
                                                <span><%= user.firstName ? user.firstName.charAt(0).toUpperCase() : '?' %></span>
                                            </div>
                                            <div class="flex-grow-1">
                                                <h5 class="card-title mb-0"><%= user.firstName %> <%= user.lastName %></h5>
                                                <small class="text-muted"><%= user.contactNumber %></small>
                                            </div>
                                            <div class="text-end">
                                                <span class="badge badge-<%= user.role.toLowerCase().replace(' ', '-') %>"><%= user.role %></span>
                                                <div class="text-muted small mt-1">
                                                    <i class="bi bi-calendar-event"></i>
                                                    <%= user.createdAt.toLocaleDateString() %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            <% } %> <%# End if user.role !== 'Super Admin' %>
                        <% }) %>
                        <%# Check if any non-Super Admin users were actually displayed %>
                        <% if (displayedUsersMobile === 0) { %>
                            <div class="card text-center py-5">
                                <div class="card-body">
                                   <p class="text-muted">No users found for your branch.</p>
                                   <a href="/admin/users/add" class="btn btn-primary mt-2">Add User</a>
                               </div>
                           </div>
                        <% } %>
                    <% } else { %>
                        <div class="card text-center py-5">
                            <div class="card-body">
                               <p class="text-muted">No users found. Click "Add User" to get started.</p>
                           </div>
                       </div>
                    <% } %>
                </div>
            </main>
        </div>
    </div>
    <%- include('../partials/adminBottomNav', { activePage: 'users' }) %>
</div>

<%# --- DESKTOP VIEW --- %>
<div class="admin-main-container d-none d-lg-block">
    <div class="admin-page-header">
        <div>
            <h2 class="h3 mb-0">Users</h2>
             <%# Filter out Super Admins for the count (though controller already does) %>
             <% const nonSuperAdminUsersDesktop = users.filter(user => user.role !== 'Super Admin'); %>
            <p class="text-muted"><%= nonSuperAdminUsersDesktop.length %> team members</p>
        </div>
        <a href="/admin/users/add" class="btn btn-primary fw-bold">
            <i class="bi bi-plus-lg me-1"></i> Add User
        </a>
    </div>
    <div class="list-table-container">
        <div class="p-3">
             <div class="form-floating">
                <input type="search" class="form-control" id="searchUsersDesktop" placeholder="Search users...">
                <label for="searchUsersDesktop"><i class="bi bi-search me-2"></i>Search users...</label>
             </div>
        </div>
        <% if (users && users.length > 0) { %>
            <div class="list-table-header" style="grid-template-columns: 70px 2fr 1.5fr 1fr 1fr auto;">
                 <span></span> <%# Avatar column header %>
                 <span>Full Name</span>
                 <span>Contact Number</span>
                 <span>Role</span>
                 <span>Joined</span>
                 <span class="text-end">Actions</span>
             </div>
            <div class="user-list-desktop">
                 <% let displayedUsersDesktop = 0; %> <%# Counter for displayed users %>
                 <% users.forEach(user => { %>
                    <%# Added: Explicit check to skip Super Admin role %>
                    <% if (user.role !== 'Super Admin') { %>
                        <% displayedUsersDesktop++; %>
                        <div class="list-table-row" style="grid-template-columns: 70px 2fr 1.5fr 1fr 1fr auto;">
                            <div>
                                <div class="user-avatar-initial">
                                    <span><%= user.firstName ? user.firstName.charAt(0).toUpperCase() : '?' %></span>
                                </div>
                            </div>
                            <div class="fw-bold"><%= user.firstName %> <%= user.lastName %></div>
                            <div><%= user.contactNumber %></div>
                            <div>
                                <span class="badge badge-<%= user.role.toLowerCase().replace(' ', '-') %>"><%= user.role %></span>
                            </div>
                            <div class="text-muted"><%= user.createdAt.toLocaleDateString('en-CA') %></div>
                            <div class="text-end">
                                <a href="/admin/users/edit/<%= user._id %>" class="btn btn-sm btn-outline-secondary">
                                     Edit
                                </a>
                                <%# Delete button intentionally removed for Admin role %>
                            </div>
                        </div>
                    <% } %> <%# End if user.role !== 'Super Admin' %>
                <% }) %>
                 <%# Check if any non-Super Admin users were actually displayed %>
                 <% if (displayedUsersDesktop === 0) { %>
                    <div class="text-center py-5">
                        <p class="text-muted">No users found for your branch (excluding Super Admins).</p>
                         <a href="/admin/users/add" class="btn btn-primary mt-2">Add User</a>
                    </div>
                 <% } %>
            </div>
        <% } else { %>
            <div class="text-center py-5">
                <p class="text-muted">No users found. Click "Add User" to get started.</p>
            </div>
        <% } %>
    </div>
</div>

<%# Add unique badge styles if not already present in style.css %>
<style>
    .badge-admin { background-color: var(--admin-bg); color: var(--admin-text); }
    .badge-front-liner { background-color: var(--frontliner-bg); color: var(--frontliner-text); }
    .badge-cook { background-color: var(--cook-bg); color: var(--cook-text); }
    .badge-assistant-manager { background-color: #6E6E6E; color: white; }
</style>


<%- include('../partials/adminFooter') %>

<script>
// Basic search functionality
document.addEventListener('DOMContentLoaded', () => {
    const createSearchFilter = (inputId, listSelector, itemSelector, nameSelector, contactSelector) => {
        const searchInput = document.getElementById(inputId);
        if (searchInput) {
            const items = document.querySelectorAll(`${listSelector} ${itemSelector}`);
            searchInput.addEventListener('input', (e) => {
                const searchTerm = e.target.value.toLowerCase().trim();
                items.forEach(item => {
                    // Skip filtering if item is already hidden by EJS role check (check if style.display is 'none')
                    if (item.style.display === 'none' && !nameSelector) return; // Basic check, might need refinement

                    const nameElement = item.querySelector(nameSelector);
                    const contactElement = item.querySelector(contactSelector);
                    const name = nameElement ? nameElement.innerText.toLowerCase() : '';
                    const contact = contactElement ? contactElement.innerText.toLowerCase() : '';

                    let matchesSearch = name.includes(searchTerm) || contact.includes(searchTerm);

                    // Only modify display if it wasn't already hidden by EJS
                     if (item.getAttribute('data-initial-display') !== 'none') { // Use a data attribute if needed
                        if (matchesSearch) {
                            item.style.display = listSelector.includes('desktop') ? 'grid' : 'block';
                        } else {
                            item.style.display = 'none';
                        }
                     }
                });
            });
        }
    };

    createSearchFilter('searchUsersMobile', '.user-list-mobile', '.user-card-link', '.card-title', '.text-muted');
    createSearchFilter('searchUsersDesktop', '.user-list-desktop', '.list-table-row', '.fw-bold', 'div:nth-child(3)');
});
</script>