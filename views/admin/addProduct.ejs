<%- include('../partials/adminHeader') %>

<%# This is the main desktop navigation, which is always present at the top. %>
<%- include('../partials/adminDesktopNav', { activePage: 'products' }) %>

<div class="d-lg-none">

    <div class="admin-container">
        <%# Sidebar is removed %>
        <div class="admin-content">
            <%- include('../partials/adminNavbar') %>

            <main class="p-3">
                <div class="page-header d-flex justify-content-between align-items-center mb-4">
                    <h2 class="h3 mb-0">Add New Product</h2>
                    <a href="/admin/products" class="btn btn-outline-secondary">
                        Back to Products
                    </a>
                </div>

                <div class="card form-card">
                    <div class="card-body">
                        <form action="/admin/products/add" method="POST">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="nameMobile" name="name" placeholder="Product Name" required>
                                <label for="nameMobile">Product Name</label>
                            </div>
                            
                            <div class="form-floating mb-3">
                                <select name="category" id="categoryMobile" class="form-select" required>
                                    <option value="" hidden selected>-- Select Category --</option>
                                    <% categories.forEach(cat => { %>
                                        <option value="<%= cat._id %>"><%= cat.name %></option>
                                    <% }) %>
                                    <option value="__add_new__" class="text-primary fw-bold">+ Add New Category</option>
                                </select>
                                <label for="categoryMobile">Category</label>
                            </div>

                            <hr>

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="mb-0">Pricing & Variants</h5>
                                <button class="btn btn-primary" type="button" id="add-size-btn-mobile">
                                    <i class="bi bi-plus-lg"></i> Add Variant
                                </button>
                            </div>

                            <div id="price-container-mobile">
                                <div class="form-floating mb-3">
                                    <input type="number" class="form-control" name="price[]" step="0.01" min="0" placeholder="Price" required>
                                    <label>Price</label>
                                </div>
                            </div>

                            <div id="size-price-container-mobile">
                                </div>
                            
                            <hr>

                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="imageUrlMobile" name="imageUrl" placeholder="Image URL (Optional)">
                                <label for="imageUrlMobile">Image URL (Optional)</label>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 btn-lg">Add Product</button>
                        </form>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <%- include('../partials/adminBottomNav', { activePage: 'products' }) %>
</div>


<div class="admin-main-container d-none d-lg-block">
    <div class="admin-page-header">
        <div>
            <h2 class="h3 mb-0">Add New Product</h2>
            <p class="text-muted">Fill in the details to create a new product.</p>
        </div>
        <a href="/admin/products" class="btn btn-outline-secondary d-flex align-items-center">
            <i class="bi bi-x-lg me-1"></i> Cancel
        </a>
    </div>

    <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
        <div class="alert alert-danger" role="alert">
            <strong>Error:</strong>
            <ul>
                <% errors.forEach(error => { %>
                    <li><%= error %></li>
                <% }) %>
            </ul>
        </div>
    <% } %>


    <div class="card form-card">
        <div class="card-body p-4">
            <form action="/admin/products/add" method="POST">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" id="nameDesktop" name="name" placeholder="Product Name" required>
                            <label for="nameDesktop">Product Name</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                         <div class="form-floating mb-3">
                            <select name="category" id="categoryDesktop" class="form-select" required>
                                <option value="" hidden selected>-- Select Category --</option>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat._id %>"><%= cat.name %></option>
                                <% }) %>
                                <option value="__add_new__" class="text-primary fw-bold">+ Add New Category</option>
                            </select>

                            <label for="categoryDesktop">Category</label>
                        </div>
                    </div>
                </div>

                <div class="form-floating mb-4">
                    <input type="text" class="form-control" id="imageUrlDesktop" name="imageUrl" placeholder="Image URL (Optional)">
                    <label for="imageUrlDesktop">Image URL (Optional)</label>
                </div>

                <hr>
                
                <div class="d-flex justify-content-between align-items-center my-3">
                    <h5 class="mb-0">Pricing & Variants</h5>
                    <button class="btn btn-primary" type="button" id="add-size-btn-desktop">
                        <i class="bi bi-plus-lg"></i> Add Variant
                    </button>
                </div>

                <div id="price-container-desktop">
                    <div class="form-floating mb-3">
                        <input type="number" class="form-control" name="price[]" step="0.01" min="0" placeholder="Price" required>
                        <label>Price</label>
                    </div>
                </div>

                <div id="size-price-container-desktop">
                    </div>
                
                <hr class="mt-4">

                <div class="text-end">
                    <button type="submit" class="btn btn-primary btn-lg">Add Product</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ADD CATEGORY MODAL -->
<div class="modal fade" id="addCategoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

        <div class="modal-header">
            <h5 class="modal-title">Add New Category</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
            <div class="form-floating">
            <input type="text" class="form-control" id="newCategoryName" placeholder="">
            <label for="newCategoryName">Category Name</label>
            </div>
            <div id="categoryError" class="text-danger small mt-2 d-none"></div>
        </div>

        <div class="modal-footer">
            <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button class="btn btn-primary" id="saveCategoryBtn">Save</button>
        </div>

        </div>
    </div>
</div>

<script>
  const addSizeBtn = document.getElementById('add-size-btn');
  const priceContainer = document.getElementById('price-container');
  const sizePriceContainer = document.getElementById('size-price-container');

  // 🧩 Function: create a new size + price row
  function createSizePriceRow() {
    const sizePriceGroup = document.createElement('div');
    sizePriceGroup.classList.add(
      'row',
      'mb-3',
      'align-items-center',
      'justify-content-center',
      'size-price-row'
    );

    sizePriceGroup.innerHTML = `
      <div class="col-md-5">
        <div class="form-floating mb-3">
          <input type="text" class="form-control" name="size[]" placeholder="Size" required>
          <label>Size</label>
        </div>
      </div>

      <div class="col-md-5">
        <div class="form-floating mb-3">
          <input type="number" class="form-control" name="price[]" step="0.01" min="0" placeholder="Price" required>
          <label>Price</label>
        </div>
      </div>

      <div class="col-md-2 text-center">
        <button type="button" class="btn btn-outline-danger btn-remove-size" title="Remove">
          <i class="bi bi-trash"></i>
        </button>
      </div>
    `;

    // Attach remove handler
    const removeBtn = sizePriceGroup.querySelector('.btn-remove-size');
    removeBtn.addEventListener('click', () => {
      sizePriceGroup.remove();

      // 🟢 If no sizes left, restore the default price input
      if (!sizePriceContainer.querySelector('.size-price-row')) {
        restoreDefaultPriceInput();
      }
    });

    return sizePriceGroup;
  }

  // 🧩 Function: restore the single default price input
  function restoreDefaultPriceInput() {
    priceContainer.style.display = 'block';
    priceContainer.innerHTML = `
      <div class="form-floating mb-3">
        <input type="number" class="form-control" id="price" name="price[]" step="0.01" min="0" placeholder="Price" required>
        <label for="price">Price</label>
      </div>
    `;
  }

  // 🧩 Handle "Add Size" button
  addSizeBtn.addEventListener('click', () => {
    // Hide single-price input when switching to multi-size mode
    priceContainer.innerHTML = '';
    priceContainer.style.display = 'none';

    // Create & append new size-price row
    const newRow = createSizePriceRow();
    sizePriceContainer.appendChild(newRow);
  });
</script>


<%- include('../partials/adminFooter') %>

<script>

document.addEventListener('DOMContentLoaded', () => {
    //for Mobile:
    const categoryMobile = document.getElementById("categoryMobile");
    const categoryDesktop = document.getElementById("categoryDesktop");

    const modalEl = document.getElementById("addCategoryModal");
    const categoryModal = bootstrap.Modal.getOrCreateInstance(modalEl);

    // Reset select helper
    const resetSelect = select => { if (select) select.value = ""; };

    // Open modal when selecting "+ Add New Category"
    [categoryMobile, categoryDesktop].forEach(select => {
        if (!select) return;

        select.addEventListener("change", () => {
            if (select.value === "__add_new__") {
                categoryModal.show();
                resetSelect(select);
            }
        });
    });

    // Save Category
    document.getElementById("saveCategoryBtn").addEventListener("click", async () => {
        const nameInput = document.getElementById("newCategoryName");
        const errorBox = document.getElementById("categoryError");

        const name = nameInput.value.trim();

        if (!name) {
            errorBox.textContent = "Category name is required.";
            errorBox.classList.remove("d-none");
            return;
        }

        errorBox.classList.add("d-none");

        const res = await fetch("/admin/categories/modal/add", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ name })
        });

        const data = await res.json();

        if (!res.ok) {
            console.log("Error Adding Category")
            errorBox.textContent = data.message || "Error adding category.";
            errorBox.classList.remove("d-none");
            return;
        }

        // Add new category to both dropdowns
        const addNewOptionDesktop = categoryDesktop.querySelector('option[value="__add_new__"]');
        const addNewOptionMobile = categoryMobile.querySelector('option[value="__add_new__"]');

        // Create the new option
        const option = document.createElement("option");
        option.value = data.category._id;
        option.textContent = data.category.name;

        // Insert before the "Add new category" option
        if (categoryMobile) categoryMobile.insertBefore(option.cloneNode(true), addNewOptionMobile);
        if (categoryDesktop) categoryDesktop.insertBefore(option.cloneNode(true), addNewOptionDesktop);

        categoryModal.hide();

        document.getElementById('categoryMobile').value = data.category._id;
        document.getElementById('categoryDesktop').value = data.category._id;

        showToast(data.message, data.type);
    });

    // Toast
    function showToast(msg, type) {
        const t = document.createElement("div");
        const messageType = type === "success" ? "success" : "danger";

        t.className = "toast text-white show position-fixed end-0 m-3";
        t.style.zIndex = "9999"; // above modals
        t.style.top = "40px"; // push below navbar

        t.innerHTML = `
            <div class="toast-body d-flex justify-content-between align-items-center bg-${messageType}">
                ${msg}
                <button class="btn-close btn-close-white ms-2" onclick="this.parentElement.parentElement.remove()"></button>
            </div>
        `;

        document.body.appendChild(t);

        setTimeout(() => t.remove(), 3000);
    }
    // ================== SCRIPT FOR MOBILE FORM ==================
    const addSizeBtnMobile = document.getElementById('add-size-btn-mobile');
    const priceContainerMobile = document.getElementById('price-container-mobile');
    const sizePriceContainerMobile = document.getElementById('size-price-container-mobile');

    if (addSizeBtnMobile) {
        const createSizePriceRowMobile = () => {
            const row = document.createElement('div');
            row.classList.add('row', 'g-2', 'mb-2', 'align-items-center', 'size-price-row');
            row.innerHTML = `
                <div class="col-5"><div class="form-floating"><input type="text" class="form-control" name="size[]" placeholder="Size" required><label>Size</label></div></div>
                <div class="col-5"><div class="form-floating"><input type="number" class="form-control" name="price[]" step="0.01" min="0" placeholder="Price" required><label>Price</label></div></div>
                <div class="col-2 text-center"><button type="button" class="btn btn-outline-danger btn-remove-size"><i class="bi bi-trash"></i></button></div>
            `;
            row.querySelector('.btn-remove-size').addEventListener('click', () => {
                row.remove();
                if (!sizePriceContainerMobile.querySelector('.size-price-row')) {
                    priceContainerMobile.innerHTML = '<div class="form-floating mb-3"><input type="number" class="form-control" name="price[]" step="0.01" min="0" placeholder="Price" required><label>Price</label></div>';
                }
            });
            return row;
        };

        addSizeBtnMobile.addEventListener('click', () => {
            if (priceContainerMobile.innerHTML !== '') {
                priceContainerMobile.innerHTML = ''; 
            }
            sizePriceContainerMobile.appendChild(createSizePriceRowMobile());
        });
    }

    // ================== SCRIPT FOR DESKTOP FORM ==================
    const addSizeBtnDesktop = document.getElementById('add-size-btn-desktop');
    const priceContainerDesktop = document.getElementById('price-container-desktop');
    const sizePriceContainerDesktop = document.getElementById('size-price-container-desktop');

    if (addSizeBtnDesktop) {
        const createSizePriceRowDesktop = () => {
            const row = document.createElement('div');
            row.classList.add('row', 'g-2', 'mb-2', 'align-items-center', 'size-price-row');
            row.innerHTML = `
                <div class="col-5"><div class="form-floating"><input type="text" class="form-control" name="size[]" placeholder="Size" required><label>Size</label></div></div>
                <div class="col-5"><div class="form-floating"><input type="number" class="form-control" name="price[]" step="0.01" min="0" placeholder="Price" required><label>Price</label></div></div>
                <div class="col-2 text-center"><button type="button" class="btn btn-outline-danger btn-remove-size"><i class="bi bi-trash"></i></button></div>
            `;
            row.querySelector('.btn-remove-size').addEventListener('click', () => {
                row.remove();
                if (!sizePriceContainerDesktop.querySelector('.size-price-row')) {
                    priceContainerDesktop.innerHTML = '<div class="form-floating mb-3"><input type="number" class="form-control" name="price[]" step="0.01" min="0" placeholder="Price" required><label>Price</label></div>';
                }
            });
            return row;
        };
        
        addSizeBtnDesktop.addEventListener('click', () => {
            if (priceContainerDesktop.innerHTML !== '') {
                priceContainerDesktop.innerHTML = '';
            }
            sizePriceContainerDesktop.appendChild(createSizePriceRowDesktop());
        });
    }
});
</script>