<%- include('../partials/adminHeader') %>

<%# This is the main desktop navigation, which is always present at the top. %>
<%- include('../partials/adminDesktopNav', { activePage: 'categories' }) %>

<div class="d-lg-none">

    <%# This is your original mobile layout container. %>
    <div class="admin-container">
        
        <%# The sidebar include has been REMOVED from here. %>

        <%# The admin-content and mobile navbar are PRESERVED. %>
        <div class="admin-content">
            <%- include('../partials/adminNavbar') %>

            <main class="p-3">
                <div class="page-header d-flex justify-content-between align-items-center mb-4">
                    <h2 class="h3">Categories</h2>
                    <a href="/admin/categories/add" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-2"></i>Add New
                    </a>
                </div>

                <div class="product-list">
                    <% if (categories.length > 0) { %>
                        <% categories.forEach(category => { %>
                            <div class="card product-card mb-3">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h5 class="card-title mb-1"><%= category.name %></h5>
                                        <div class="d-flex gap-2">
                                            <a href="/admin/categories/edit/<%= category._id %>" class="btn btn-sm btn-outline-secondary">Edit</a>
                                            <form action="/admin/categories/delete/<%= category._id %>" method="POST" onsubmit="return confirm('Are you sure?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="card text-center py-5">
                            <p class="text-muted">No Categories found. Click "Add New" to get started.</p>
                        </div>
                    <% } %>
                </div>
            </main>
        </div>
    </div>

    <%# Your mobile-only bottom navigation is also preserved. %>
    <%- include('../partials/adminBottomNav', { activePage: 'categories' }) %>
</div>


<div class="admin-main-container d-none d-lg-block">
    <div class="admin-page-header">
        <div>
            <h2 class="h3 mb-0">Categories</h2>
            <p class="text-muted">Manage your product categories.</p>
        </div>
        <a href="/admin/categories/add" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Add New Category
        </a>
    </div>

    <% if (categories.length > 0) { %>
        <div class="list-table-container">
            <div class="list-table-header" style="grid-template-columns: 1fr auto;">
                <span>CATEGORY</span>
                <span class="text-end">ACTIONS</span>
            </div>

            <% categories.forEach(category => { %>
                <div class="list-table-row" style="grid-template-columns: 1fr auto;">
                    <div>
                        <h6 class="mb-0 fw-bold"><%= category.name %></h6>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <a href="/admin/categories/edit/<%= category._id %>" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form action="/admin/categories/delete/<%= category._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this category?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="card text-center py-5">
             <div class="card-body">
                <h5 class="card-title">No Categories Found</h5>
                <p class="text-muted">Get started by adding your first product category.</p>
                <a href="/admin/categories/add" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-lg me-2"></i>Add a Category
                </a>
            </div>
        </div>
    <% } %>
</div>


<%- include('../partials/adminFooter') %>