<%- include('../partials/adminHeader') %>

<%- include('../partials/adminDesktopNav', { activePage: 'products' }) %>

<%# --- MOBILE VIEW --- %>
<div class="d-lg-none">
    <div class="admin-container">
        <div class="admin-content">
            <%- include('../partials/adminNavbar') %>
            <main class="p-3">
                <div class="page-header d-flex justify-content-between align-items-center mb-4">
                    <h2 class="h3">Edit Product</h2>
                    <a href="/admin/products" class="btn btn-outline-secondary">Cancel</a>
                </div>

                <div class="card form-card">
                    <div class="card-body">
                        <form action="/admin/products/update/<%= product._id %>" method="POST">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="nameMobile" name="name" placeholder="Product Name" value="<%= product.name %>" required>
                                <label for="nameMobile">Product Name</label>
                            </div>
                            
                            <div class="form-floating mb-3">
                                <select name="category" id="categoryMobile" class="form-select" required>
                                    <% categories.forEach(cat => { %>
                                        <option value="<%= cat._id %>" <%= String(cat._id) === String(product.category) ? 'selected' : '' %>><%= cat.name %></option>
                                    <% }) %>
                                </select>
                                <label for="categoryMobile">Category</label>
                            </div>

                            <hr>

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="mb-0">Pricing & Variants</h5>
                                <button class="btn btn-primary" type="button" id="add-size-btn-mobile">
                                    <i class="bi bi-plus-lg"></i> Add Variant
                                </button>
                            </div>

                            <div id="price-container-mobile" class="mb-3">
                                <% if(sizes.length === 0) { %>
                                    <div class="price-history-group">
                                        <% if (pastSinglePrices && pastSinglePrices.length > 0) { %>
                                            <div class="dropdown">
                                                <button class="btn btn-price-history" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="View Price History">
                                                    <i class="bi bi-clock-history"></i>
                                                </button>
                                                <ul class="dropdown-menu">
                                                    <% pastSinglePrices.forEach(price => { %>
                                                        <li><a class="dropdown-item price-history-item" href="#" data-price="<%= price.price %>">
                                                            <span>₱<%= price.price.toFixed(2) %></span>
                                                            <small><%= new Date(price.effectiveDate).toLocaleDateString('en-PH', { month: 'short', day: 'numeric' }) %></small>
                                                        </a></li>
                                                    <% }) %>
                                                </ul>
                                            </div>
                                        <% } %>
                                        <div class="form-floating flex-grow-1">
                                            <input type="number" class="form-control" name="price[]" step="0.01" min="0" placeholder="Price" value="<%= product.price %>" required>
                                            <label>Price</label>
                                        </div>
                                    </div>
                                <% } %>
                            </div>

                            <div id="size-price-container-mobile">
                                <% if (sizes.length > 0) { %>
                                    <% sizes.forEach(size => { %>
                                    <% const correspondingPrice = prices.find(p => p.sizeId && p.sizeId.toString() === size._id.toString()); %>
                                    <%# Added: Filter past prices for the current size %>
                                    <% const variantPastPrices = pastSizePrices.filter(p => p.sizeId && p.sizeId.toString() === size._id.toString()); %>
                                    <div class="row g-2 mb-2 align-items-center size-price-row">
                                        <div class="col-5">
                                            <div class="form-floating">
                                                <input type="text" class="form-control" name="size[]" placeholder="Size" value="<%= size.label %>" required>
                                                <label>Size</label>
                                            </div>
                                        </div>
                                        <div class="col-5">
                                            <div class="price-history-group">
                                                <%# Updated: Check the new filtered array %>
                                                 <% if (variantPastPrices && variantPastPrices.length > 0) { %>
                                                    <div class="dropdown">
                                                        <button class="btn btn-price-history" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="View Price History">
                                                            <i class="bi bi-clock-history"></i>
                                                        </button>
                                                        <ul class="dropdown-menu">
                                                            <%# Updated: Loop through the new filtered array %>
                                                            <% variantPastPrices.forEach(price => { %>
                                                                <li><a class="dropdown-item price-history-item" href="#" data-price="<%= price.price %>">
                                                                    <span>₱<%= price.price.toFixed(2) %></span>
                                                                    <small><%= new Date(price.effectiveDate).toLocaleDateString('en-PH', { month: 'short', day: 'numeric' }) %></small>
                                                                </a></li>
                                                            <% }) %>
                                                        </ul>
                                                    </div>
                                                <% } %>
                                                <div class="form-floating flex-grow-1">
                                                    <input type="number" class="form-control" name="price[]" step="0.01" min="0" placeholder="Price" value="<%= correspondingPrice ? correspondingPrice.price : '' %>" required>
                                                    <label>Price</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-2 text-center">
                                            <button type="button" class="btn btn-outline-danger btn-remove-size" title="Remove">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <% }) %>
                                <% } %>
                            </div>

                            <hr>

                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="imageUrlMobile" name="imageUrl" placeholder="Image URL (Optional)" value="<%= product.imageUrl || '' %>">
                                <label for="imageUrlMobile">Image URL (Optional)</label>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 btn-lg">Save Changes</button>
                        </form>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <%- include('../partials/adminBottomNav', { activePage: 'products' }) %>
</div>


<%# --- DESKTOP VIEW --- %>
