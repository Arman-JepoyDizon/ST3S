<%- include('../partials/adminHeader') %>

<%# This is the main desktop navigation, which is always present at the top. %>
<%- include('../partials/adminDesktopNav', { activePage: 'products' }) %>

<div class="d-lg-none">

    <div class="admin-container">
        <%# Sidebar is removed %>
        <div class="admin-content">
            <%- include('../partials/adminNavbar') %>

            <main class="p-3">
                <div class="page-header d-flex justify-content-between align-items-center mb-4">
                    <h2 class="h3">Edit Product</h2>
                    <a href="/admin/products" class="btn btn-outline-secondary">Cancel</a>
                </div>

                <div class="card form-card">
                    <div class="card-body">
                        <form action="/admin/products/update/<%= product._id %>" method="POST">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="nameMobile" name="name" placeholder="Product Name" value="<%= product.name %>" required>
                                <label for="nameMobile">Product Name</label>
                            </div>
                            
                            <div class="form-floating mb-3">
                                <select name="category" id="categoryMobile" class="form-select" required>
                                    <% categories.forEach(cat => { %>
                                        <option value="<%= cat._id %>" <%= String(cat._id) === String(product.category) ? 'selected' : '' %>><%= cat.name %></option>
                                    <% }) %>
                                </select>
                                <label for="categoryMobile">Category</label>
                            </div>

                            <hr>

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="mb-0">Pricing & Variants</h5>
                                <button class="btn btn-primary" type="button" id="add-size-btn-mobile">
                                    <i class="bi bi-plus-lg"></i> Add Variant
                                </button>
                            </div>

                            <div id="price-container-mobile">
                                <% if(sizes.length === 0) { %>
                                    <div class="form-floating mb-3">
                                        <input type="number" class="form-control" name="price[]" step="0.01" min="0" placeholder="Price" value="<%= product.price %>" required>
                                        <label>Price</label>
                                    </div>
                                <% } %>
                            </div>

                            <div id="size-price-container-mobile">
                                <% if (sizes.length > 0) { %>
                                    <% sizes.forEach(size => { %>
                                        <% const correspondingPrice = prices.find(p => p.sizeId && p.sizeId.toString() === size._id.toString()); %>
                                        <div class="row g-2 mb-2 align-items-center size-price-row">
                                            <div class="col-5"><div class="form-floating"><input type="text" class="form-control" name="size[]" placeholder="Size" value="<%= size.label %>" required><label>Size</label></div></div>
                                            <div class="col-5"><div class="form-floating"><input type="number" class="form-control" name="price[]" step="0.01" min="0" placeholder="Price" value="<%= correspondingPrice ? correspondingPrice.price : '' %>" required><label>Price</label></div></div>
                                            <div class="col-2 text-center"><button type="button" class="btn btn-outline-danger btn-remove-size" title="Remove"><i class="bi bi-trash"></i></button></div>
                                        </div>
                                    <% }) %>
                                <% } %>
                            </div>
                            
                            <hr>

                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="imageUrlMobile" name="imageUrl" placeholder="Image URL (Optional)" value="<%= product.imageUrl || '' %>">
                                <label for="imageUrlMobile">Image URL (Optional)</label>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 btn-lg">Save Changes</button>
                        </form>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <%- include('../partials/adminBottomNav', { activePage: 'products' }) %>
</div>


<div class="admin-main-container d-none d-lg-block">
    <div class="admin-page-header">
        <div>
            <h2 class="h3 mb-0">Edit Product</h2>
            <p class="text-muted">Update the details for <%= product.name %>.</p>
        </div>
        <a href="/admin/products" class="btn btn-outline-secondary d-flex align-items-center">
            <i class="bi bi-x-lg me-1"></i> Cancel
        </a>
    </div>

    <div class="card form-card">
        <div class="card-body p-4">
            <form action="/admin/products/update/<%= product._id %>" method="POST">
                 <div class="row">
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" id="nameDesktop" name="name" placeholder="Product Name" value="<%= product.name %>" required>
                            <label for="nameDesktop">Product Name</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                         <div class="form-floating mb-3">
                            <select name="category" id="categoryDesktop" class="form-select" required>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat._id %>" <%= String(cat._id) === String(product.category) ? 'selected' : '' %>><%= cat.name %></option>
                                <% }) %>
                            </select>
                            <label for="categoryDesktop">Category</label>
                        </div>
                    </div>
                </div>

                <div class="form-floating mb-4">
                    <input type="text" class="form-control" id="imageUrlDesktop" name="imageUrl" placeholder="Image URL (Optional)" value="<%= product.imageUrl || '' %>">
                    <label for="imageUrlDesktop">Image URL (Optional)</label>
                </div>

                <hr>
                
                <div class="d-flex justify-content-between align-items-center my-3">
                    <h5 class="mb-0">Pricing & Variants</h5>
                    <button class="btn btn-primary" type="button" id="add-size-btn-desktop">
                        <i class="bi bi-plus-lg"></i> Add Variant
                    </button>
                </div>

                <div id="price-container-desktop">
                     <% if(sizes.length === 0) { %>
                        <div class="form-floating mb-3">
                            <input type="number" class="form-control" name="price[]" step="0.01" min="0" placeholder="Price" value="<%= product.price %>" required>
                            <label>Price</label>
                        </div>
                    <% } %>
                </div>

                <div id="size-price-container-desktop">
                    <% if (sizes.length > 0) { %>
                        <% sizes.forEach(size => { %>
                            <% const correspondingPrice = prices.find(p => p.sizeId && p.sizeId.toString() === size._id.toString()); %>
                            <div class="row g-2 mb-2 align-items-center size-price-row">
                                <div class="col-5"><div class="form-floating"><input type="text" class="form-control" name="size[]" placeholder="Size" value="<%= size.label %>" required><label>Size</label></div></div>
                                <div class="col-5"><div class="form-floating"><input type="number" class="form-control" name="price[]" step="0.01" min="0" placeholder="Price" value="<%= correspondingPrice ? correspondingPrice.price : '' %>" required><label>Price</label></div></div>
                                <div class="col-2 text-center"><button type="button" class="btn btn-outline-danger btn-remove-size" title="Remove"><i class="bi bi-trash"></i></button></div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
                
                <hr class="mt-4">

                <div class="text-end">
                    <button type="submit" class="btn btn-primary btn-lg">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
  const addSizeBtn = document.getElementById('add-size-btn');
  const priceContainer = document.getElementById('price-container');
  const sizePriceContainer = document.getElementById('size-price-container');
  const form = document.querySelector('form');

  // 🔹 Attach delete behavior to a button
  function attachRemoveEvent(button) {
    button.addEventListener('click', () => {
        const row = button.closest('.row');
        if (!row) return;

        // Handle deleted sizes (from DB)
        const hiddenInput = row.querySelector('input[name="sizeId"]');
        if (hiddenInput) {
        const deletedInput = document.createElement('input');
        deletedInput.type = 'hidden';
        deletedInput.name = 'deletedSizes[]';
        deletedInput.value = hiddenInput.value;
        form.appendChild(deletedInput);
        }

        // Remove row visually
        row.remove();

        // ✅ Corrected condition
        if (sizePriceContainer.querySelectorAll('.size-price-row').length === 0) {
        restoreSinglePriceInput();
        }
    });
    }
  // 🔹 Attach to all existing delete buttons
  document.querySelectorAll('.btn-remove-size').forEach(btn => attachRemoveEvent(btn));

  // 🔹 Function to restore the single price field
  function restoreSinglePriceInput() {
    if (!priceContainer) return;
    priceContainer.style.display = 'block';
    priceContainer.innerHTML = `
      <div class="form-floating mb-3">
        <input type="number" class="form-control" id="price" name="price[]" step="0.01" min="0" placeholder="Price" required>
        <label for="price">Price</label>
      </div>
    `;
  }

  // 🔹 Add new size rows dynamically
  addSizeBtn.addEventListener('click', () => {
    // Hide single price input when switching to multi-size mode
    if (priceContainer) {
      priceContainer.innerHTML = '';
      priceContainer.style.display = 'none';
    }

    const sizePriceGroup = document.createElement('div');
    sizePriceGroup.classList.add('row', 'mb-3', 'align-items-center', 'justify-content-center', 'size-price-row');

    sizePriceGroup.innerHTML = `
      <div class="col-md-5">
        <div class="form-floating mb-3">
          <input type="text" class="form-control" name="size[]" placeholder="Size" required>
          <label>Size</label>
        </div>
      </div>

      <div class="col-md-5">
        <div class="form-floating mb-3">
          <input type="number" class="form-control" name="price[]" step="0.01" min="0" placeholder="Price" required>
          <label>Price</label>
        </div>
      </div>

      <div class="col-md-2 text-center">
        <button type="button" class="btn btn-outline-danger btn-remove-size" title="Remove">
          <i class="bi bi-trash"></i>
        </button>
      </div>
    `;

    sizePriceContainer.appendChild(sizePriceGroup);

    // Attach delete behavior to the new button
    const removeBtn = sizePriceGroup.querySelector('.btn-remove-size');
    attachRemoveEvent(removeBtn);
  });
</script>


<%- include('../partials/adminFooter') %>

<script>
document.addEventListener('DOMContentLoaded', () => {

    // Helper function to set up logic for a given form (mobile or desktop)
    const setupForm = (formElement) => {
        if (!formElement) return;

        const addSizeBtn = formElement.querySelector('.btn-primary[id^="add-size-btn"]');
        const priceContainer = formElement.querySelector('[id^="price-container"]');
        const sizePriceContainer = formElement.querySelector('[id^="size-price-container"]');

        const attachRemoveEvent = (button) => {
            button.addEventListener('click', () => {
                button.closest('.size-price-row').remove();
                if (sizePriceContainer.querySelectorAll('.size-price-row').length === 0) {
                    priceContainer.innerHTML = `<div class="form-floating mb-3"><input type="number" class="form-control" name="price[]" step="0.01" min="0" placeholder="Price" required><label>Price</label></div>`;
                }
            });
        };

        formElement.querySelectorAll('.btn-remove-size').forEach(attachRemoveEvent);

        addSizeBtn.addEventListener('click', () => {
            if (priceContainer) priceContainer.innerHTML = '';
            
            const newRow = document.createElement('div');
            newRow.classList.add('row', 'g-2', 'mb-2', 'align-items-center', 'size-price-row');
            newRow.innerHTML = `
                <div class="col-5"><div class="form-floating"><input type="text" class="form-control" name="size[]" placeholder="Size" required><label>Size</label></div></div>
                <div class="col-5"><div class="form-floating"><input type="number" class="form-control" name="price[]" step="0.01" min="0" placeholder="Price" required><label>Price</label></div></div>
                <div class="col-2 text-center"><button type="button" class="btn btn-outline-danger btn-remove-size" title="Remove"><i class="bi bi-trash"></i></button></div>
            `;
            sizePriceContainer.appendChild(newRow);
            attachRemoveEvent(newRow.querySelector('.btn-remove-size'));
        });
    };

    // Setup for Mobile Form
    setupForm(document.querySelector('.d-lg-none form'));
    
    // Setup for Desktop Form
    setupForm(document.querySelector('.d-none.d-lg-block form'));
});
</script>