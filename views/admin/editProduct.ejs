                            <select name="category" id="categoryDesktop" class="form-select" required>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat._id %>" <%= String(cat._id) === String(product.category) ? 'selected' : '' %>><%= cat.name %></option>
                                <% }) %>
                            </select>
                            <label for="categoryDesktop">Category</label>
                        </div>
                    </div>
                </div>

                <div class="form-floating mb-4">
                    <input type="text" class="form-control" id="imageUrlDesktop" name="imageUrl" placeholder="Image URL (Optional)" value="<%= product.imageUrl || '' %>">
                    <label for="imageUrlDesktop">Image URL (Optional)</label>
                </div>

                <hr>
                
                <div class="d-flex justify-content-between align-items-center my-3">
                    <h5 class="mb-0">Pricing & Variants</h5>
                    <button class="btn btn-primary" type="button" id="add-size-btn-desktop">
                        <i class="bi bi-plus-lg"></i> Add Variant
                    </button>
                </div>

                <div id="price-container-desktop" class="mb-3">
                    <% if (sizes.length === 0) { %>
                        <div class="price-history-group">
                            <% if (pastSinglePrices && pastSinglePrices.length > 0) { %>
                                <div class="dropdown">
                                    <button class="btn btn-price-history" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="View Price History">
                                        <i class="bi bi-clock-history"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <% pastSinglePrices.forEach(price => { %>
                                            <li><a class="dropdown-item price-history-item" href="#" data-price="<%= price.price %>">
                                                <span>₱<%= price.price.toFixed(2) %></span>
                                                <small><%= new Date(price.effectiveDate).toLocaleDateString('en-PH', { month: 'short', day: 'numeric' }) %></small>
                                            </a></li>
                                        <% }) %>
                                    </ul>
                                </div>
                            <% } %>
                             <div class="form-floating flex-grow-1">
                                <input type="number" class="form-control" name="price[]" step="0.01" min="0" placeholder="Price" value="<%= product.price %>" required>
                                <label>Price</label>
                            </div>
                        </div>
                    <% } %>
                </div>

                <div id="size-price-container-desktop">
                    <% if (sizes.length > 0) { %>
                        <% sizes.forEach(size => { %>
                            <% const correspondingPrice = prices.find(p => p.sizeId && p.sizeId.toString() === size._id.toString()); %>
                            <%# Added: Filter past prices for the current size %>
                            <% const variantPastPrices = pastSizePrices.filter(p => p.sizeId && p.sizeId.toString() === size._id.toString()); %>
                            <div class="row g-2 mb-2 align-items-center size-price-row">
                                <div class="col-5">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" name="size[]" placeholder="Size" value="<%= size.label %>" required>
                                        <label>Size</label>
                                    </div>
                                </div>
                                <div class="col-5">
                                    <div class="price-history-group">
                                        <%# Updated: Check the new filtered array %>
                                        <% if (variantPastPrices && variantPastPrices.length > 0) { %>
                                            <div class="dropdown">
                                                <button class="btn btn-price-history" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="View Price History">
                                                    <i class="bi bi-clock-history"></i>
                                                </button>
                                                <ul class="dropdown-menu">
                                                    <%# Updated: Loop through the new filtered array %>
                                                     <% variantPastPrices.forEach(price => { %>
                                                        <li><a class="dropdown-item price-history-item" href="#" data-price="<%= price.price %>">
                                                            <span>₱<%= price.price.toFixed(2) %></span>
                                                            <small><%= new Date(price.effectiveDate).toLocaleDateString('en-PH', { month: 'short', day: 'numeric' }) %></small>
                                                        </a></li>
                                                    <% }) %>
                                                </ul>
                                            </div>
                                        <% } %>
                                        <div class="form-floating flex-grow-1">
                                            <input type="number" class="form-control" name="price[]" step="0.01" min="0" placeholder="Price" value="<%= correspondingPrice ? correspondingPrice.price : '' %>" required>
                                            <label>Price</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-2 text-center"><button type="button" class="btn btn-outline-danger btn-remove-size" title="Remove"><i class="bi bi-trash"></i></button></div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
                
                <hr class="mt-4">

                <div class="text-end">
                    <button type="submit" class="btn btn-primary btn-lg">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/adminFooter') %>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const setupForm = (formElement) => {
        if (!formElement) return;

        const addSizeBtn = formElement.querySelector('.btn-primary[id^="add-size-btn"]');
        const priceContainer = formElement.querySelector('[id^="price-container"]');
        const sizePriceContainer = formElement.querySelector('[id^="size-price-container"]');

        const attachRemoveEvent = (button) => {
            button.addEventListener('click', () => {
                button.closest('.size-price-row').remove();
                if (sizePriceContainer.querySelectorAll('.size-price-row').length === 0) {
                    priceContainer.style.display = 'block';
                    priceContainer.innerHTML = `<div class="price-history-group"><div class="form-floating flex-grow-1"><input type="number" class="form-control" name="price[]" step="0.01" min="0" placeholder="Price" required><label>Price</label></div></div>`;
                }
            });
        };

        formElement.querySelectorAll('.btn-remove-size').forEach(attachRemoveEvent);

        addSizeBtn.addEventListener('click', () => {
            if (priceContainer) {
                priceContainer.innerHTML = '';
                priceContainer.style.display = 'none';
            }
            
            const newRow = document.createElement('div');
            newRow.classList.add('row', 'g-2', 'mb-2', 'align-items-center', 'size-price-row');
            newRow.innerHTML = `
                <div class="col-5">
                    <div class="form-floating">
                        <input type="text" class="form-control" name="size[]" placeholder="Size" required>
                        <label>Size</label>
                    </div>
                </div>
                <div class="col-5">
                     <div class="price-history-group">
                        <div class="form-floating flex-grow-1">
                            <input type="number" class="form-control" name="price[]" step="0.01" min="0" placeholder="Price" required>
                            <label>Price</label>
                        </div>
                    </div>
                </div>
                <div class="col-2 text-center">
                    <button type="button" class="btn btn-outline-danger btn-remove-size" title="Remove"><i class="bi bi-trash"></i></button>
                </div>
            `;
            sizePriceContainer.appendChild(newRow);
            attachRemoveEvent(newRow.querySelector('.btn-remove-size'));
        });
    };

    setupForm(document.querySelector('.d-lg-none form'));
    setupForm(document.querySelector('.d-none.d-lg-block form'));

    // --- Price History Dropdown Logic ---
    document.body.addEventListener('click', function(event) {
        const historyItem = event.target.closest('.price-history-item');
        if (historyItem) {
            event.preventDefault();
            const price = historyItem.dataset.price;
            const priceGroup = historyItem.closest('.price-history-group');
            if (priceGroup) {
                const input = priceGroup.querySelector('input[type="number"]');
                if (input) {
                    input.value = price;
                }
            }
        }
    });
});
</script>