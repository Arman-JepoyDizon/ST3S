<%- include('../partials/adminHeader') %>
<%- include('../partials/adminDesktopNav', { activePage: 'products' }) %>

<%# --- MOBILE VIEW --- %>
<div class="d-lg-none">
    <div class="admin-container">
        <div class="admin-content">
            <%- include('../partials/adminNavbar') %>
            <main class="p-3">
                <div class="page-header mb-4">
                    <h2 class="h3 mb-0 fw-bold">Edit Product</h2>
                    <p class="text-muted small">Editing: <%= product.name %></p>
                </div>

                <% if (locals.errors && errors.length > 0) { %>
                    <div class="alert alert-danger">
                        <ul class="mb-0 ps-3">
                            <% errors.forEach(error => { %><li><%= error %></li><% }) %>
                        </ul>
                    </div>
                <% } %>

                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <form action="/admin/products/update/<%= product._id %>" method="POST">
                            
                            <h6 class="fw-bold text-primary mb-3">Basic Info</h6>
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" name="name" placeholder="Product Name" value="<%= product.name %>" required>
                                <label>Product Name *</label>
                            </div>

                            <div class="form-floating mb-3">
                                <select name="category" class="form-select" required>
                                    <option value="" disabled>Select Category</option>
                                    <% categories.forEach(cat => { %>
                                        <option value="<%= cat._id %>" <%= String(product.category) === String(cat._id) ? 'selected' : '' %>><%= cat.name %></option>
                                    <% }) %>
                                </select>
                                <label>Category *</label>
                            </div>

                            <div class="form-floating mb-3">
                                <select name="status" class="form-select" required>
                                    <option value="Active" <%= product.status === 'Active' ? 'selected' : '' %>>Active</option>
                                    <option value="Inactive" <%= product.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
                                </select>
                                <label>Status *</label>
                            </div>

                            <div class="form-floating mb-4">
                                <input type="text" class="form-control" name="imageUrl" placeholder="Image URL" value="<%= product.imageUrl %>">
                                <label>Image URL</label>
                            </div>

                            <hr>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold text-primary mb-0">Prices & Variants</h6>
                                <button type="button" class="btn btn-sm btn-outline-primary" id="add-variant-mobile">
                                    <i class="bi bi-plus-lg"></i> Add
                                </button>
                            </div>

                            <div id="size-container-mobile">
                                <% if(product.price && product.price.length > 0) { %>
                                    <% product.price.forEach((p, index) => { %>
                                        <div class="card bg-light border-0 mb-2 variant-row">
                                            <div class="card-body p-2">
                                                <div class="row g-2">
                                                    <div class="col-5">
                                                        <input type="text" class="form-control form-control-sm" name="size[]" placeholder="Size (e.g. Large)" value="<%= p.size || '' %>">
                                                    </div>
                                                    <div class="col-5">
                                                        <input type="number" class="form-control form-control-sm" name="price[]" step="0.01" placeholder="Price" value="<%= p.price %>" required>
                                                    </div>
                                                    <div class="col-2 text-end">
                                                        <button type="button" class="btn btn-sm btn-outline-danger btn-remove-variant">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                    <input type="hidden" name="priceStatus[]" value="<%= p.status || 'Active' %>">
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <%# Default empty row if no prices exist %>
                                    <div class="card bg-light border-0 mb-2 variant-row">
                                        <div class="card-body p-2">
                                            <div class="row g-2">
                                                <div class="col-5">
                                                    <input type="text" class="form-control form-control-sm" name="size[]" placeholder="Size">
                                                </div>
                                                <div class="col-5">
                                                    <input type="number" class="form-control form-control-sm" name="price[]" step="0.01" placeholder="Price" required>
                                                </div>
                                                <div class="col-2 text-end">
                                                    <button type="button" class="btn btn-sm btn-outline-danger btn-remove-variant"><i class="bi bi-trash"></i></button>
                                                </div>
                                                <input type="hidden" name="priceStatus[]" value="Active">
                                            </div>
                                        </div>
                                    </div>
                                <% } %>
                            </div>

                            <div class="d-grid gap-2 mt-4">
                                <button type="submit" class="btn btn-primary fw-bold">Save Changes</button>
                                <a href="/admin/products" class="btn btn-light">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <%- include('../partials/adminBottomNav', { activePage: 'products' }) %>
</div>


<%# --- DESKTOP VIEW --- %>
<div class="admin-main-container d-none d-lg-block">
    <div class="admin-page-header mb-4">
        <div>
            <h2 class="h3 mb-0 fw-bold">Edit Product</h2>
            <p class="text-muted">Update details for <%= product.name %></p>
        </div>
        <a href="/admin/products" class="btn btn-outline-secondary d-flex align-items-center shadow-sm">
            <i class="bi bi-x-lg me-2"></i> Cancel
        </a>
    </div>

    <% if (locals.errors && errors.length > 0) { %>
        <div class="alert alert-danger shadow-sm">
            <h6 class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-2"></i>Please fix the following errors:</h6>
            <ul class="mb-0 small ps-3">
                <% errors.forEach(error => { %><li><%= error %></li><% }) %>
            </ul>
        </div>
    <% } %>

    <div class="card form-card border-0 shadow-sm">
        <div class="card-body p-4">
            <form action="/admin/products/update/<%= product._id %>" method="POST">
                <div class="row g-4">
                    
                    <%# Left Column: Details %>
                    <div class="col-md-6 border-end">
                        <h5 class="fw-bold text-dark mb-3">Product Details</h5>
                        
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" name="name" placeholder="Product Name" value="<%= product.name %>" required>
                            <label>Product Name *</label>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select name="category" class="form-select" required>
                                        <option value="" disabled>Select Category</option>
                                        <% categories.forEach(cat => { %>
                                            <option value="<%= cat._id %>" <%= String(product.category) === String(cat._id) ? 'selected' : '' %>><%= cat.name %></option>
                                        <% }) %>
                                    </select>
                                    <label>Category *</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select name="status" class="form-select" required>
                                        <option value="Active" <%= product.status === 'Active' ? 'selected' : '' %>>Active</option>
                                        <option value="Inactive" <%= product.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
                                    </select>
                                    <label>Status *</label>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating">
                            <input type="text" class="form-control" name="imageUrl" placeholder="Image URL" value="<%= product.imageUrl %>">
                            <label>Image URL (Optional)</label>
                        </div>
                    </div>

                    <%# Right Column: Variants %>
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-dark mb-0">Prices & Variants</h5>
                            <button type="button" class="btn btn-sm btn-primary fw-bold" id="add-variant-desktop">
                                <i class="bi bi-plus-lg me-1"></i>Add Variant
                            </button>
                        </div>

                        <div id="size-container-desktop" class="variant-list">
                            <% if(product.price && product.price.length > 0) { %>
                                <% product.price.forEach((p, index) => { %>
                                    <div class="row g-2 mb-2 align-items-center variant-row">
                                        <div class="col-5">
                                            <div class="form-floating">
                                                <input type="text" class="form-control" name="size[]" placeholder="Size" value="<%= p.size || '' %>">
                                                <label>Size (Optional)</label>
                                            </div>
                                        </div>
                                        <div class="col-5">
                                            <div class="form-floating">
                                                <input type="number" class="form-control" name="price[]" step="0.01" placeholder="Price" value="<%= p.price %>" required>
                                                <label>Price *</label>
                                            </div>
                                        </div>
                                        <div class="col-2 text-center">
                                            <button type="button" class="btn btn-outline-danger btn-remove-variant p-2">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                        <input type="hidden" name="priceStatus[]" value="<%= p.status || 'Active' %>">
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <%# Default empty row %>
                                <div class="row g-2 mb-2 align-items-center variant-row">
                                    <div class="col-5">
                                        <div class="form-floating">
                                            <input type="text" class="form-control" name="size[]" placeholder="Size">
                                            <label>Size (Optional)</label>
                                        </div>
                                    </div>
                                    <div class="col-5">
                                        <div class="form-floating">
                                            <input type="number" class="form-control" name="price[]" step="0.01" placeholder="Price" required>
                                            <label>Price *</label>
                                        </div>
                                    </div>
                                    <div class="col-2 text-center">
                                        <button type="button" class="btn btn-outline-danger btn-remove-variant p-2"><i class="bi bi-trash"></i></button>
                                    </div>
                                    <input type="hidden" name="priceStatus[]" value="Active">
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <hr class="mt-4 mb-4">

                <div class="text-end">
                    <button type="submit" class="btn btn-success btn-lg px-5 fw-bold shadow-sm">
                        <i class="bi bi-check-circle-fill me-2"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/adminFooter') %>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Function to create a new variant row (Responsive HTML)
    const createVariantRow = (isMobile) => {
        const div = document.createElement('div');
        
        if (isMobile) {
            div.className = 'card bg-light border-0 mb-2 variant-row';
            div.innerHTML = `
                <div class="card-body p-2">
                    <div class="row g-2">
                        <div class="col-5"><input type="text" class="form-control form-control-sm" name="size[]" placeholder="Size"></div>
                        <div class="col-5"><input type="number" class="form-control form-control-sm" name="price[]" step="0.01" placeholder="Price" required></div>
                        <div class="col-2 text-end"><button type="button" class="btn btn-sm btn-outline-danger btn-remove-variant"><i class="bi bi-trash"></i></button></div>
                        <input type="hidden" name="priceStatus[]" value="Active">
                    </div>
                </div>`;
        } else {
            div.className = 'row g-2 mb-2 align-items-center variant-row';
            div.innerHTML = `
                <div class="col-5"><div class="form-floating"><input type="text" class="form-control" name="size[]" placeholder="Size"><label>Size (Optional)</label></div></div>
                <div class="col-5"><div class="form-floating"><input type="number" class="form-control" name="price[]" step="0.01" placeholder="Price" required><label>Price *</label></div></div>
                <div class="col-2 text-center"><button type="button" class="btn btn-outline-danger btn-remove-variant p-2"><i class="bi bi-trash"></i></button></div>
                <input type="hidden" name="priceStatus[]" value="Active">`;
        }
        return div;
    };

    // Function to attach remove listener to container
    const attachRemoveListener = (container) => {
        container.addEventListener('click', (e) => {
            const btn = e.target.closest('.btn-remove-variant');
            if (btn) {
                // Only remove if there's more than one row, or clear values if it's the last one
                const rows = container.querySelectorAll('.variant-row');
                if (rows.length > 1) {
                    btn.closest('.variant-row').remove();
                } else {
                    const inputs = btn.closest('.variant-row').querySelectorAll('input');
                    inputs.forEach(input => input.value = '');
                }
            }
        });
    };

    // Mobile Setup
    const mobileContainer = document.getElementById('size-container-mobile');
    const mobileAddBtn = document.getElementById('add-variant-mobile');
    if (mobileContainer && mobileAddBtn) {
        mobileAddBtn.addEventListener('click', () => {
            mobileContainer.appendChild(createVariantRow(true));
        });
        attachRemoveListener(mobileContainer);
    }

    // Desktop Setup
    const desktopContainer = document.getElementById('size-container-desktop');
    const desktopAddBtn = document.getElementById('add-variant-desktop');
    if (desktopContainer && desktopAddBtn) {
        desktopAddBtn.addEventListener('click', () => {
            desktopContainer.appendChild(createVariantRow(false));
        });
        attachRemoveListener(desktopContainer);
    }
});
</script>