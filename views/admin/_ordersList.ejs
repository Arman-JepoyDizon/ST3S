<%# File: views/admin/_ordersList.ejs %>
<%# Renders the list of transactions for mobile or desktop %>

<% if (target === 'mobile') { %>
    <%# --- MOBILE LIST --- %>
    <div class="transaction-list-mobile">
        <% if (transactions && transactions.length > 0) { %>
            <% transactions.forEach(transaction => { %>
                <div class="card transaction-card mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="fw-bold">ORD-<%= transaction._id.toString().slice(-6).toUpperCase() %></h6>
                                <% if (transaction.customerName) { %><p class="text-primary fw-bold mb-0 customer-name-display"><i class="bi bi-person-badge"></i> <%= transaction.customerName %></p><% } %>
                                <small class="text-muted d-block mt-1"><i class="bi bi-calendar-event"></i> <%= new Date(transaction.createdAt).toLocaleDateString() %></small>
                                <small class="text-muted d-block"><i class="bi bi-person"></i> <%= transaction.createdBy ? transaction.createdBy.username : 'N/A' %></small>
                                <small class="text-muted d-block"><i class="bi bi-credit-card"></i> <%= transaction.paymentMethod %></small>
                            </div>
                            <% if (transaction.status === 'Completed') { %><span class="badge badge-status-completed">Completed</span>
                            <% } else if (transaction.status === 'Cancelled') { %><span class="badge badge-status-cancelled">Cancelled</span>
                            <% } else if (transaction.status === 'Ready') { %><span class="badge badge-status-ready">Ready</span>
                            <% } else { %><span class="badge badge-status-pending">Pending</span><% } %>
                        </div>
                        <ul class="list-group list-group-flush sales-item-list my-2">
                            <% transaction.items.forEach(item => { %>
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-1">
                                    <div>
                                        <span class="fw-bold"><%= item.quantity %>x</span> <%= item.productId ? item.productId.name : 'Product not found' %>
                                        <% if (item.sizeLabel) { %><small class="d-block text-muted ps-4"><%= item.sizeLabel %></small><% } %>
                                    </div>
                                    <span class="fw-bold text-muted">₱<%= (item.price * item.quantity).toFixed(2) %></span>
                                </li>
                            <% }) %>
                        </ul>
                        <div class="border-top pt-2">
                            <% if (transaction.discountApplied) { %>
                                <div class="d-flex justify-content-between"><p class="text-muted mb-1 small">Subtotal</p><p class="fw-bold text-muted mb-1 small">₱<%= (transaction.totalAmount + transaction.discountAmount).toFixed(2) %></p></div>
                                <div class="d-flex justify-content-between"><p class="text-muted mb-1 small">Discount (20%)</p><p class="fw-bold text-danger mb-1 small">- ₱<%= transaction.discountAmount.toFixed(2) %></p></div>
                                <hr class="my-1">
                            <% } %>
                            <div class="d-flex justify-content-between align-items-center">
                                <p class="text-muted mb-0 fw-bold">Total</p>
                                <p class="fw-bold text-primary fs-5 mb-0">₱<%= transaction.totalAmount.toFixed(2) %></p>
                            </div>
                        </div>
                         <%# Added: Button to trigger modal - pass transaction data %>
                         <hr class="my-2">
                         <div class="text-end">
                             <button type="button" class="btn btn-outline-secondary btn-sm view-order-btn"
                                 data-bs-toggle="modal" data-bs-target="#orderDetailsModal"
                                 data-transaction='<%- JSON.stringify(transaction) %>'>
                                 View Details
                             </button>
                         </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="card text-center py-5">
                <i class="bi bi-receipt-cutoff fs-1 text-muted mb-3"></i>
                <h5 class="mb-1">No Transactions Found</h5>
                <p class="text-muted">No records match your current filters.</p>
                 <button type="button" class="btn btn-light mt-2" onclick="document.getElementById('clear-filters-mobile').click();">Clear Filters</button>
            </div>
        <% } %>
    </div>

<% } else { %>
    <%# --- DESKTOP LIST --- %>
    <div class="list-table-container">
        <% if (transactions && transactions.length > 0) { %>
            <div class="list-table-header orders-grid">
                <div>Order Number</div> <div>Date & Time</div> <div>Payment</div> <div>Total</div> <div>Status</div> <div class="text-end">Actions</div>
            </div>
            <div class="transaction-list-desktop">
                <% transactions.forEach(transaction => { %>
                    <div class="list-table-row orders-grid">
                        <div class="fw-bold">ORD-<%= transaction._id.toString().slice(-6).toUpperCase() %></div>
                        <div><%= new Date(transaction.createdAt).toLocaleString() %></div>
                        <div><%= transaction.paymentMethod %></div>
                        <div class="fw-bold text-primary">
                            <% if (transaction.discountApplied) { %><span class="text-decoration-line-through text-muted small">₱<%= (transaction.totalAmount + transaction.discountAmount).toFixed(2) %></span><br><% } %>
                            ₱<%= transaction.totalAmount.toFixed(2) %>
                        </div>
                        <div>
                             <% if (transaction.status === 'Completed') { %><span class="badge badge-status-completed">Completed</span>
                             <% } else if (transaction.status === 'Cancelled') { %><span class="badge badge-status-cancelled">Cancelled</span>
                             <% } else if (transaction.status === 'Ready') { %><span class="badge badge-status-ready">Ready</span>
                             <% } else { %><span class="badge badge-status-pending">Pending</span><% } %>
                        </div>
                        <div class="text-end">
                             <%# Pass transaction data to button %>
                            <button type="button" class="btn btn-outline-secondary btn-sm view-order-btn"
                                data-bs-toggle="modal" data-bs-target="#orderDetailsModal"
                                data-transaction='<%- JSON.stringify(transaction) %>'>
                                View
                            </button>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-5">
                <i class="bi bi-receipt-cutoff fs-1 text-muted mb-3"></i>
                <h5 class="mb-1">No Transactions Found</h5>
                <p class="text-muted">No records match your current filters.</p>
                 <button type="button" class="btn btn-light mt-2" onclick="document.getElementById('clear-filters-desktop').click();">Clear Filters</button>
            </div>
        <% } %>
    </div>
<% } %>