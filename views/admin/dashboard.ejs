<%- include('../partials/adminHeader') %>
<%- include('../partials/adminDesktopNav', { activePage: 'analytics' }) %>

<%# --- MOBILE VIEW --- %>
<div class="d-lg-none">
    <div class="admin-container">
        <div class="admin-content">
            <%- include('../partials/adminNavbar') %>
            <main class="p-3">
                <div class="page-header mb-3">
                    <h2 class="h3 mb-0">Sales Analytics</h2>
                    <p class="text-muted">Track your business performance</p>
                </div>

                <div class="filter-controls-mobile mb-4">
                    <form action="/admin/dashboard" method="GET" id="mobile-analytics-form">
                        <div class="d-flex mb-2">
                            <a href="/admin/dashboard?filter=today" class="btn <%= currentFilter === 'today' ? 'btn-primary' : 'btn-outline-secondary' %> fw-bold me-2">Today</a>
                            <a href="/admin/dashboard?filter=week" class="btn <%= currentFilter === 'week' ? 'btn-primary' : 'btn-outline-secondary' %> fw-bold me-2">Week</a>
                            <a href="/admin/dashboard?filter=month" class="btn <%= currentFilter === 'month' ? 'btn-primary' : 'btn-outline-secondary' %> fw-bold me-2">Month</a>
                            <a href="/admin/dashboard?filter=year" class="btn <%= currentFilter === 'year' ? 'btn-primary' : 'btn-outline-secondary' %> fw-bold">Year</a>
                        </div>
                        <div class="form-control-icon-wrapper">
                             <i class="bi bi-calendar-range"></i>
                             <input type="text" class="form-control" id="custom-range-input-mobile" name="dateRange" placeholder="Custom Range" value="<%= query.dateRange || '' %>" readonly>
                             <input type="hidden" name="filter" value="custom">
                        </div>
                    </form>
                </div>

                <div class="row">
                    <div class="col-12 mb-3">
                        <div class="card stat-card-revamp">
                            <div class="card-body">
                                <div class="d-flex align-items-center">
                                    <div class="stat-icon-wrapper bg-success-light">
                                        <i class="bi bi-currency-dollar text-success-dark"></i>
                                    </div>
                                    <div class="ms-3">
                                        <p class="card-text text-muted mb-0">Total Sales (Completed)</p>
                                        <h3 class="card-title mb-0">₱<%= totalSales.toFixed(2) %></h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 mb-3">
                        <div class="card stat-card-revamp">
                            <div class="card-body">
                                <div class="d-flex align-items-center">
                                    <%# UPDATED: Dark Icon for Orders %>
                                    <div class="stat-icon-wrapper bg-light">
                                        <i class="bi bi-receipt text-dark"></i>
                                    </div>
                                    <div class="ms-3">
                                        <p class="card-text text-muted mb-0">Total Orders (All)</p>
                                        <h3 class="card-title mb-0"><%= totalOrders %></h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title"><%= salesTrendData.title %></h5>
                        <canvas id="salesTrendChartMobile"></canvas>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Top Products (by Quantity Sold)</h5>
                        <canvas id="topProductsChartMobile" style="max-height: 250px;"></canvas>
                    </div>
                </div>
            
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Best Sellers (by Revenue)</h5>
                        <% if (bestSellers && bestSellers.length > 0) { %>
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span class="fw-bold text-muted small">PRODUCT</span>
                                    <span class="fw-bold text-muted small">REVENUE</span>
                                </li>
                                <% bestSellers.forEach(item => { %>
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <div>
                                            <p class="mb-0 fw-bold"><%= item.productDetails.name %><% if (item._id.sizeLabel) { %> - <%= item._id.sizeLabel %><% } %></p>
                                            <small class="text-muted"><%= item.totalQuantity %> sold</small>
                                        </div>
                                        <span class="fw-bold">₱<%= item.totalRevenue.toFixed(2) %></span>
                                    </li>
                                <% }) %>
                            </ul>
                        <% } else { %>
                            <p class="text-muted">No completed sales data available yet.</p>
                        <% } %>
                    </div>
                </div>

                <div class="recent-transactions mt-4">
                    <h2 class="h4">Recent Transactions</h2>
                    <% if (recentTransactions && recentTransactions.length > 0) { %>
                        <% recentTransactions.forEach(transaction => { %>
                            <div class="card transaction-card mb-3">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="fw-bold">ORD-<%= transaction._id.toString().slice(-6).toUpperCase() %></h6>
                                            <% if (transaction.customerName) { %>
                                                <p class="text-primary fw-bold mb-0 customer-name-display">
                                                    <i class="bi bi-person-badge"></i> 
                                                    <%= transaction.customerName %>
                                                </p>
                                            <% } %>
                                            <small class="text-muted d-block mt-1">
                                                <i class="bi bi-person"></i> 
                                                <%= transaction.createdBy ? transaction.createdBy.username : 'N/A' %>
                                            </small>
                                        </div>
                                        <% if (transaction.status === 'Completed') { %>
                                            <span class="badge badge-status-completed">Completed</span>
                                        <% } else if (transaction.status === 'Cancelled') { %>
                                            <span class="badge badge-status-cancelled">Cancelled</span>
                                        <% } else if (transaction.status === 'Ready') { %>
                                            <span class="badge badge-status-ready">Ready</span>
                                        <% } else { %>
                                            <span class="badge badge-status-pending">Pending</span>
                                        <% } %>
                                    </div>
                                    <ul class="list-group list-group-flush sales-item-list my-2">
                                        <% transaction.items.forEach(item => { %>
                                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-1">
                                                <div>
                                                    <span class="fw-bold"><%= item.quantity %>x</span> <%= item.productId ? item.productId.name : 'Product not found' %>
                                                    <% if (item.sizeLabel) { %>
                                                        <small class="d-block text-muted ps-4"><%= item.sizeLabel %></small>
                                                    <% } %>
                                                </div>
                                                <span class="fw-bold text-muted">₱<%= (item.price * item.quantity).toFixed(2) %></span>
                                            </li>
                                        <% }) %>
                                    </ul>
                                    <div class="d-flex justify-content-between align-items-center border-top pt-2">
                                        <p class="text-muted mb-0 fw-bold">Total</p>
                                        <%# UPDATED: Dark Amount Color %>
                                        <p class="fw-bold text-dark fs-5 mb-0">₱<%= transaction.totalAmount.toFixed(2) %></p>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="card text-center py-5">
                            <p class="text-muted">No transactions have been made yet.</p>
                        </div>
                    <% } %>
                </div>
            </main>
        </div>
    </div>
    <%- include('../partials/adminBottomNav', { activePage: 'analytics' }) %>
</div>


<%# --- DESKTOP VIEW --- %>
<div class="admin-main-container d-none d-lg-block">
    <div class="admin-page-header">
        <div>
            <h2 class="h3 mb-0">Sales Analytics</h2>
            <p class="text-muted">Track your business performance</p>
        </div>
        <form action="/admin/dashboard" method="GET" id="desktop-analytics-form" class="d-flex align-items-center">
            <a href="/admin/dashboard?filter=today" class="btn <%= currentFilter === 'today' ? 'btn-primary' : 'btn-outline-secondary' %> fw-bold me-2">Today</a>
            <a href="/admin/dashboard?filter=week" class="btn <%= currentFilter === 'week' ? 'btn-primary' : 'btn-outline-secondary' %> fw-bold me-2">Week</a>
            <a href="/admin/dashboard?filter=month" class="btn <%= currentFilter === 'month' ? 'btn-primary' : 'btn-outline-secondary' %> fw-bold me-2">Month</a>
            <a href="/admin/dashboard?filter=year" class="btn <%= currentFilter === 'year' ? 'btn-primary' : 'btn-outline-secondary' %> fw-bold me-2">Year</a>
            <div class="position-relative form-control-icon-wrapper">
                 <i class="bi bi-calendar-range"></i>
                 <input type="text" id="custom-range-input-desktop" name="dateRange" class="form-control" placeholder="Custom Range" value="<%= query.dateRange || '' %>" readonly>
                 <input type="hidden" name="filter" value="custom">
            </div>
        </form>
    </div>

    <div class="row">
        <div class="col-lg-4 mb-3">
            <div class="card stat-card-revamp h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon-wrapper bg-success-light">
                            <i class="bi bi-currency-dollar text-success-dark"></i>
                        </div>
                        <div class="ms-3">
                            <p class="card-text text-muted mb-0">Total Sales</p>
                            <h3 class="card-title mb-0">₱<%= totalSales.toFixed(2) %></h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4 mb-3">
            <div class="card stat-card-revamp h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <%# UPDATED: Dark Icon %>
                        <div class="stat-icon-wrapper bg-light">
                            <i class="bi bi-receipt text-dark"></i>
                        </div>
                        <div class="ms-3">
                            <p class="card-text text-muted mb-0">Total Orders</p>
                            <h3 class="card-title mb-0"><%= totalOrders %></h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4 mb-3">
            <div class="card stat-card-revamp h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <%# UPDATED: Dark/Subtle Icon for Average %>
                        <div class="stat-icon-wrapper bg-secondary-subtle">
                            <i class="bi bi-graph-up-arrow text-dark"></i>
                        </div>
                        <div class="ms-3">
                            <p class="card-text text-muted mb-0">Average Order</p>
                            <h3 class="card-title mb-0">₱<%= (totalOrders > 0 ? (totalSales / totalOrders).toFixed(2) : '0.00') %></h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-7 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title"><%= salesTrendData.title %></h5>
                    <canvas id="salesTrendChartDesktop"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-5 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Top Products (by Quantity)</h5>
                    <canvas id="topProductsChartDesktop"></canvas>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mt-2">
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Best Sellers (by Revenue)</h5>
                    <% if (bestSellers && bestSellers.length > 0) { %>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between px-0">
                                <span class="fw-bold text-muted small">PRODUCT</span>
                                <span class="fw-bold text-muted small">REVENUE</span>
                            </li>
                            <% bestSellers.forEach(item => { %>
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div>
                                        <p class="mb-0 fw-bold"><%= item.productDetails.name %><% if (item._id.sizeLabel) { %> - <%= item._id.sizeLabel %><% } %></p>
                                        <small class="text-muted"><%= item.totalQuantity %> sold</small>
                                    </div>
                                    <span class="fw-bold">₱<%= item.totalRevenue.toFixed(2) %></span>
                                </li>
                            <% }) %>
                        </ul>
                    <% } else { %>
                        <p class="text-muted">No completed sales data available yet.</p>
                    <% } %>
                </div>
            </div>
        </div>
        <div class="col-lg-6 mb-4">
            <h5 class="card-title mb-3">Recent Transactions</h5>
            <% if (recentTransactions && recentTransactions.length > 0) { %>
                <% recentTransactions.forEach(transaction => { %>
                    <div class="card transaction-card mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="fw-bold">ORD-<%= transaction._id.toString().slice(-6).toUpperCase() %></h6>
                                    <% if (transaction.customerName) { %>
                                        <p class="text-primary fw-bold mb-0 customer-name-display">
                                            <i class="bi bi-person-badge"></i> <%= transaction.customerName %>
                                        </p>
                                    <% } %>
                                </div>
                                <% if (transaction.status === 'Completed') { %>
                                    <span class="badge badge-status-completed">Completed</span>
                                <% } else if (transaction.status === 'Cancelled') { %>
                                    <span class="badge badge-status-cancelled">Cancelled</span>
                                <% } else if (transaction.status === 'Ready') { %>
                                    <span class="badge badge-status-ready">Ready</span>
                                <% } else { %>
                                    <span class="badge badge-status-pending">Pending</span>
                                <% } %>
                            </div>
                            <hr class="my-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <p class="text-muted mb-0 small"><%= new Date(transaction.createdAt).toLocaleString() %></p>
                                <%# UPDATED: Dark Amount Color %>
                                <p class="fw-bold text-dark fs-5 mb-0">₱<%= transaction.totalAmount.toFixed(2) %></p>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="card text-center py-5">
                    <p class="text-muted">No transactions have been made yet.</p>
                </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('../partials/adminFooter') %>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // --- CHART.JS LOGIC ---
        try {
            const salesTrendData = <%- JSON.stringify(salesTrendData) %>;
            const topProductsData = <%- JSON.stringify(topProductsData) %>;

            // Define multi-color palette (Primary Colors & more)
            const multiColors = [
                '#0d6efd', // Blue
                '#dc3545', // Red
                '#ffc107', // Yellow
                '#198754', // Green
                '#6f42c1', // Purple
                '#fd7e14', // Orange
                '#0dcaf0', // Cyan
                '#20c997'  // Teal
            ];

            const createSalesChart = (canvasId) => {
                const ctx = document.getElementById(canvasId);
                if (!ctx || !salesTrendData || !salesTrendData.labels || !salesTrendData.data) return;
                
                new Chart(ctx.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: salesTrendData.labels,
                        datasets: [{
                            label: 'Sales',
                            data: salesTrendData.data,
                            // Use single primary color for time series, looks cleaner, but array works too
                            backgroundColor: '#0d6efd', 
                            borderColor: '#0d6efd',
                            borderWidth: 1,
                            borderRadius: 8
                        }]
                    },
                    options: {
                        scales: { y: { beginAtZero: true } },
                        plugins: { legend: { display: false } }
                    }
                });
            };
            
            const createTopProductsChart = (canvasId) => {
                const ctx = document.getElementById(canvasId);
                if (!ctx || !topProductsData || !topProductsData.labels || !topProductsData.data) return;
                
                new Chart(ctx.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: topProductsData.labels,
                        datasets: [{
                            label: 'Quantity Sold',
                            data: topProductsData.data,
                            // UPDATED: Use multi-color palette
                            backgroundColor: multiColors,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        plugins: { legend: { position: 'right' } }
                    }
                });
            };

            createSalesChart('salesTrendChartMobile');
            createSalesChart('salesTrendChartDesktop');
            createTopProductsChart('topProductsChartMobile');
            createTopProductsChart('topProductsChartDesktop');
        
        } catch (error) {
            console.error("Error initializing charts:", error);
        }

        // --- FLATPCIKR INITIALIZATION FOR DASHBOARD ---
        const initFlatpickrForForm = (formId, inputId) => {
            const form = document.getElementById(formId);
            const input = document.getElementById(inputId);
            if (!form || !input) return;

            flatpickr(input, {
                mode: "range",
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "M j",
                onClose: function(selectedDates, dateStr, instance) {
                    if (selectedDates.length === 2) {
                        form.submit();
                    }
                }
            });
        };

        initFlatpickrForForm('desktop-analytics-form', 'custom-range-input-desktop');
        initFlatpickrForForm('mobile-analytics-form', 'custom-range-input-mobile');
    });
</script>