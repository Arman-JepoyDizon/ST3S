<%# Export Modal %>
<div class="modal fade" id="exportModal" tabindex="-1" aria-labelledby="exportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="exportModalLabel"><i class="bi bi-download me-2"></i>Export Transactions</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <%# Date Range Selection %>
                <div class="mb-4">
                    <label class="form-label fw-bold text-muted small text-uppercase">Date Range</label>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <button class="btn btn-sm btn-outline-primary date-preset-btn" data-range="today">Today</button>
                        <button class="btn btn-sm btn-outline-primary date-preset-btn" data-range="week">This Week</button>
                        <button class="btn btn-sm btn-outline-primary date-preset-btn" data-range="month">This Month</button>
                        <button class="btn btn-sm btn-outline-primary date-preset-btn" data-range="3months">Last 3 Months</button>
                    </div>
                    <input type="text" id="export-date-range" class="form-control" placeholder="Select custom date range (optional)">
                </div>
                <%# Status Filter %>
                <div class="mb-4">
                    <label for="export-status-filter" class="form-label fw-bold text-muted small text-uppercase">Status Filter</label>
                    <select id="export-status-filter" class="form-select">
                        <option value="">All Status</option>
                        <option value="Pending">Pending</option>
                        <option value="Ready">Ready</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
                <%# Fields Selection %>
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-bold text-muted small text-uppercase mb-0">Fields to Export</label>
                        <div><a href="#" class="select-all-fields me-2 text-decoration-none">Select All</a><a href="#" class="deselect-all-fields text-decoration-none">Deselect All</a></div>
                    </div>
                    <div class="export-fields-grid">
                        <div class="form-check"><input class="form-check-input" type="checkbox" name="exportFields" value="orderId" id="field-orderId" checked><label class="form-check-label" for="field-orderId">Order Number</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" name="exportFields" value="date" id="field-date" checked><label class="form-check-label" for="field-date">Date</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" name="exportFields" value="time" id="field-time" checked><label class="form-check-label" for="field-time">Time</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" name="exportFields" value="status" id="field-status" checked><label class="form-check-label" for="field-status">Status</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" name="exportFields" value="items" id="field-items" checked><label class="form-check-label" for="field-items">Item Details</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" name="exportFields" value="totalAmount" id="field-totalAmount" checked><label class="form-check-label" for="field-totalAmount">Total Amount</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" name="exportFields" value="createdBy" id="field-createdBy" checked><label class="form-check-label" for="field-createdBy">Created By</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" name="exportFields" value="paymentMethod" id="field-paymentMethod"><label class="form-check-label" for="field-paymentMethod">Payment Method</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" name="exportFields" value="customerName" id="field-customerName"><label class="form-check-label" for="field-customerName">Customer Name</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" name="exportFields" value="discount" id="field-discount"><label class="form-check-label" for="field-discount">Discount Details</label></div>
                    </div>
                </div>
                <%# Export Summary %>
                <div class="alert alert-success export-summary">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    <div><span class="fw-bold">Export Summary</span><br>This will export <strong id="export-count">...</strong> transactions with <strong id="export-columns-count">...</strong> columns.</div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary fw-bold" id="final-export-btn"><i class="bi bi-download me-2"></i>Export</button>
            </div>
        </div>
    </div>
</div>


<!-- STEP 1 — Delete Warning Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger" id="deleteModalLabel">
                    <i class="bi bi-trash fs-3 mx-auto text-danger"></i> Clear Transaction Records
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4">
                <label class="text-uppercase h2 fw-700">
                    Are You Sure You Want to Clear ALL Transaction Records?
                </label>
                <h4 class="mt-3">This will:</h4>
                <ul>
                    <li class="text-danger">Remove all product transaction records</li>
                    <li class="text-danger">Cannot be undone</li>
                </ul>
            </div>

            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">
                    Cancel
                </button>

                <!-- Continue to Step 2 -->
                <button type="button" class="btn btn-danger fw-bold" data-bs-target="#confirmDeleteModal" data-bs-toggle="modal">
                    <i class="bi bi-arrow-right me-2"></i>Continue
                </button>
            </div>
        </div>
    </div>
</div>



<!-- STEP 2 — Confirm Backup or Final Delete Modal -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">

            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger" id="confirmDeleteModalLabel">
                    <i class="bi bi-exclamation-triangle fs-3 text-danger"></i>
                    Final Confirmation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4">
                <label class="text-uppercase h2 fw-700">
                    Do you want a backup before deleting?
                </label>

                <div class="d-flex flex-column gap-3 mt-4">
                    
                    <!-- OPTION 1: No Backup -->
                    <button class="btn btn-danger btn-lg fw-bold deleteTransactionsBtn" id="confirm-delete-transactions">
                        <i class="bi bi-trash me-2"></i>
                        Delete Now
                    </button>

                    <!-- OPTION 2: With Backup -->
                    <button class="btn btn-primary btn-lg fw-bold deleteTransactionsBtn" id="export-all-btn">
                        <i class="bi bi-download me-2"></i>
                        Download Backup
                    </button>

                    <!-- Cancel -->
                    <button class="btn btn-light fw-bold" data-bs-dismiss="modal">
                        Cancel
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>

<%- include('../partials/adminFooter') %>

<script>
document.addEventListener('DOMContentLoaded', () => {

    //toast
    function showToast(message, type) {
        const messageType = type === "success" ? "success" : "danger";

        const toast = document.createElement('div');
        toast.className = `toast align-items-center text-white bg-${messageType} border-0 show position-fixed end-0`;
        toast.style.zIndex = 9999;
        toast.style.top = '50px'; // 50px from top
        toast.style.right = '20px'; // 20px from right
        toast.innerHTML = `
            <div class="d-flex">
                <div class="toast-body">${message}</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        `;
        document.body.appendChild(toast);

        // Auto remove after 3 seconds
        setTimeout(() => {
            toast.classList.remove('show');
            toast.remove();
        }, 3000);
    }

    // Parse URL query parameters
    const urlParams = new URLSearchParams(window.location.search);
    const message = urlParams.get('message');
    const type = urlParams.get('type') || 'success';

    if (message) {
        showToast(message, type);

        // Remove query parameters from URL without reload
        const cleanUrl = window.location.pathname;
        window.history.replaceState({}, document.title, cleanUrl);
    }

    // --- Flatpickr Initialization ---
    flatpickr(".flatpickr-range", {
        mode: "range", dateFormat: "Y-m-d", altInput: true, altFormat: "M j, Y", allowInput: true,
        onClose: function(selectedDates, dateStr, instance) { if (typeof instance._initialValue === 'undefined') { instance._initialValue = instance.input.value; } if (instance.input.value !== instance._initialValue) { fetchAndUpdateOrders(); instance._initialValue = instance.input.value; } },
        onOpen: function(selectedDates, dateStr, instance) { instance._initialValue = instance.input.value; }
    });

    //confirm delete modal
   const confirmDeleteTransactions = document.getElementById("confirm-delete-transactions")
   confirmDeleteTransactions.addEventListener('click', ()=>{
    window.location.href = '/admin/orders/delete'
   })

    // --- Filter Logic ---
    const searchInputMobile = document.getElementById('searchOrdersMobile');
    const dateInputMobile = document.getElementById('filter-date-range-mobile');
    const statusInputMobile = document.getElementById('status-filter-mobile');
    const clearMobileBtn = document.getElementById('clear-filters-mobile');
    const listContainerMobile = document.getElementById('transaction-list-container-mobile');
    const countMobileEl = document.getElementById('transaction-count-mobile');
    const totalMobileEl = document.getElementById('total-branch-count-mobile');
    const searchInputDesktop = document.getElementById('searchOrdersDesktop');
    const dateInputDesktop = document.getElementById('filter-date-range-desktop');
    const statusInputDesktop = document.getElementById('status-filter-desktop');
    const clearDesktopBtn = document.getElementById('clear-filters-desktop');
    const listContainerDesktop = document.getElementById('transaction-list-container-desktop');
    const countDesktopEl = document.getElementById('transaction-count-desktop');
    const totalDesktopEl = document.getElementById('total-branch-count-desktop');
    let fetchTimeout;

    async function fetchAndUpdateOrders() {
        const isMobileView = searchInputMobile && searchInputMobile.offsetParent !== null;
        const searchVal = isMobileView ? (searchInputMobile ? searchInputMobile.value : '') : (searchInputDesktop ? searchInputDesktop.value : '');
        const dateVal = isMobileView ? (dateInputMobile ? dateInputMobile.value : '') : (dateInputDesktop ? dateInputDesktop.value : '');
        const statusVal = isMobileView ? (statusInputMobile ? statusInputMobile.value : '') : (statusInputDesktop ? statusInputDesktop.value : '');
        const params = new URLSearchParams();
        if (searchVal) params.append('search', searchVal);
        if (dateVal) params.append('dateRange', dateVal);
        if (statusVal) params.append('status', statusVal);
        const queryString = params.toString();
        const newUrl = `${window.location.pathname}${queryString ? '?' + queryString : ''}`;
        window.history.replaceState({ path: newUrl }, '', newUrl);
        try {
            const loadingHTML = '<div class="text-center p-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>';
            if(listContainerMobile) listContainerMobile.innerHTML = loadingHTML;
            if(listContainerDesktop) listContainerDesktop.innerHTML = loadingHTML;
            
            const [mobileHtmlResponse, desktopHtmlResponse, dataResponse] = await Promise.all([
                fetch(`/admin/orders/renderList?${queryString}&target=mobile`),
                fetch(`/admin/orders/renderList?${queryString}&target=desktop`),
                fetch(`/admin/orders/data?${queryString}`)
            ]);
            if (!mobileHtmlResponse.ok || !desktopHtmlResponse.ok || !dataResponse.ok) throw new Error('Error fetching data');
            
            const mobileHtml = await mobileHtmlResponse.text();
            const desktopHtml = await desktopHtmlResponse.text();
            const data = await dataResponse.json();
            
            if(listContainerMobile) listContainerMobile.innerHTML = mobileHtml;
            if(listContainerDesktop) listContainerDesktop.innerHTML = desktopHtml;
            if(countMobileEl) countMobileEl.textContent = data.totalFilteredCount;
            if(totalMobileEl) totalMobileEl.textContent = data.totalBranchCount;
            if(countDesktopEl) countDesktopEl.textContent = data.totalFilteredCount;
            if(totalDesktopEl) totalDesktopEl.textContent = data.totalBranchCount;
            
            attachModalListeners(); // Re-attach listeners after DOM update
        } catch (error) {
            console.error("Error fetching or rendering orders:", error);
        }
    }

    function addFilterListeners(searchInput, dateInput, statusInput) { 
        if (searchInput) { searchInput.addEventListener('input', () => { clearTimeout(fetchTimeout); fetchTimeout = setTimeout(fetchAndUpdateOrders, 400); }); } 
        if (statusInput) { statusInput.addEventListener('change', fetchAndUpdateOrders); } 
    }
    addFilterListeners(searchInputMobile, dateInputMobile, statusInputMobile);
    addFilterListeners(searchInputDesktop, dateInputDesktop, statusInputDesktop);

    function clearFilters() { 
        if(searchInputMobile) searchInputMobile.value = ''; 
        const fpMobile = dateInputMobile ? flatpickr(dateInputMobile) : null; if(fpMobile) fpMobile.clear(); 
        if(statusInputMobile) statusInputMobile.value = ''; 
        if(searchInputDesktop) searchInputDesktop.value = ''; 
        const fpDesktop = dateInputDesktop ? flatpickr(dateInputDesktop) : null; if(fpDesktop) fpDesktop.clear(); 
        if(statusInputDesktop) statusInputDesktop.value = ''; 
        fetchAndUpdateOrders(); 
    }
    if(clearMobileBtn) clearMobileBtn.addEventListener('click', clearFilters);
    if(clearDesktopBtn) clearDesktopBtn.addEventListener('click', clearFilters);

    // --- Modal Logic (Attach to buttons) ---
    function attachModalListeners() {
        const orderDetailsModalElement = document.getElementById('orderDetailsModal');
        if (!orderDetailsModalElement) return;
        const orderDetailsModal = bootstrap.Modal.getOrCreateInstance(orderDetailsModalElement);
        
        const handleViewClick = (event) => { 
            const button = event.target.closest('.view-order-btn');
            if (button) { 
                event.preventDefault(); 
                const transactionJson = button.dataset.transaction; 
                if (!transactionJson) return;
                try { 
                    const transaction = JSON.parse(transactionJson); 
                    populateModal(transaction, orderDetailsModal); 
                } catch (e) { console.error("Error parsing JSON:", e); } 
            } 
        };
        
        // Remove old listeners before adding new ones to prevent duplicates
        if (listContainerMobile) { listContainerMobile.removeEventListener('click', handleViewClick); listContainerMobile.addEventListener('click', handleViewClick); }
        if (listContainerDesktop) { listContainerDesktop.removeEventListener('click', handleViewClick); listContainerDesktop.addEventListener('click', handleViewClick); }

        const populateModal = (transaction, modalInstance) => {
            // (Logic logic same as before, just ensuring it's accessible)
            const modalOrderTimestamp = document.getElementById('modal-order-timestamp');
            const modalOrderId = document.getElementById('modal-order-id');
            const modalItemsList = document.getElementById('modal-items-list');
            const modalPricingDetails = document.getElementById('modal-pricing-details');
            const modalChangeStatusBtn = document.getElementById('modal-change-status-btn');
            
            const createdAtDate = new Date(transaction.createdAt);
            modalOrderTimestamp.textContent = createdAtDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) + ' ' + createdAtDate.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
            modalOrderId.textContent = `ORD-${transaction._id.toString().slice(-10).toUpperCase()}`;
            
            modalItemsList.innerHTML = '';
            transaction.items.forEach(item => {
                const itemRow = document.createElement('div');
                itemRow.className = 'modal-item-row';
                let itemNameDisplay = item.productId ? item.productId.name : 'Product Not Found';
                if (item.sizeLabel) { itemNameDisplay += ` <small class="text-muted">(${item.sizeLabel})</small>`; }
                itemRow.innerHTML = `<span class="modal-item-name"><span class="fw-bold me-2">${item.quantity}x</span> ${itemNameDisplay}</span><span class="modal-item-price">₱${(item.price * item.quantity).toFixed(2)}</span>`;
                modalItemsList.appendChild(itemRow);
            });

            if (transaction.discountApplied) {
                const subtotal = transaction.totalAmount + transaction.discountAmount;
                modalPricingDetails.innerHTML = `<div class="d-flex justify-content-between text-muted small"><span>Subtotal</span><span>₱${subtotal.toFixed(2)}</span></div><div class="d-flex justify-content-between text-danger small"><span>Discount (20%)</span><span>- ₱${transaction.discountAmount.toFixed(2)}</span></div><hr class="my-2"><div class="d-flex justify-content-between align-items-center"><h5 class="fw-bold mb-0">Total</h5><h5 class="fw-bold text-primary mb-0 fs-4">₱${transaction.totalAmount.toFixed(2)}</h5></div>`;
            } else {
                modalPricingDetails.innerHTML = `<div class="d-flex justify-content-between align-items-center"><h5 class="fw-bold mb-0">Total</h5><h5 class="fw-bold text-primary mb-0 fs-4">₱${transaction.totalAmount.toFixed(2)}</h5></div>`;
            }

            const newStatusBtn = modalChangeStatusBtn.cloneNode(true);
            modalChangeStatusBtn.parentNode.replaceChild(newStatusBtn, modalChangeStatusBtn);
            if (transaction.status === 'Pending' || transaction.status === 'Ready') {
                newStatusBtn.style.display = 'block';
                newStatusBtn.dataset.nextStatus = transaction.status === 'Pending' ? 'Ready' : 'Completed';
                newStatusBtn.textContent = transaction.status === 'Pending' ? 'Mark as Ready' : 'Mark as Completed';
                newStatusBtn.className = `btn fw-bold btn-lg ${transaction.status === 'Pending' ? 'btn-primary' : 'btn-success'}`;
                newStatusBtn.addEventListener('click', async () => {
                    const nextStatus = newStatusBtn.dataset.nextStatus;
                    try {
                        const response = await fetch(`/admin/orders/${transaction._id}/status`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status: nextStatus }) });
                        if (response.ok) { fetchAndUpdateOrders(); modalInstance.hide(); } else { alert('Failed to update status'); }
                    } catch (error) { console.error(error); alert('Error occurred'); }
                }, { once: true });
            } else {
                newStatusBtn.style.display = 'none';
            }
            modalInstance.show();
        };
    }


    // Initial Load
    attachModalListeners();
});
</script>