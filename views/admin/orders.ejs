<%- include('../partials/adminHeader') %>
<%- include('../partials/adminDesktopNav', { activePage: 'orders' }) %>

<%# --- CUSTOM STYLES --- %>
<style>
    /* Desktop Grid - 6 Columns */
    .orders-grid-custom {
        display: grid;
        grid-template-columns: 1.5fr 1.5fr 1fr 1fr 1fr 140px; /* Fixed width for Actions */
        gap: 1rem;
        align-items: center;
    }

    /* Action Button Styling */
    .btn-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: all 0.2s ease;
        height: 38px;
    }
    
    .btn-action:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .hover-bg-light:hover {
        background-color: #f8f9fa;
    }
</style>

<%# --- MOBILE VIEW --- %>
<div class="d-lg-none">
    <div class="admin-container">
        <div class="admin-content">
            <%- include('../partials/adminNavbar') %>
            <main class="p-3">
                <div class="page-header d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h2 class="h3 mb-0">Transactions</h2>
                        <p class="text-muted mb-0"><span id="transaction-count-mobile"><%= transactions.length %></span> of <span id="total-branch-count-mobile"><%= totalTransactionsCount %></span> records</p>
                    </div>
                    <div class="">
                        <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#exportModal">
                            <i class="bi bi-download"></i>
                        </button>
                        <button type="button" class="btn btn-danger shadow-sm" data-bs-toggle="modal" data-bs-target="#deleteModal">
                            <i class="bi bi-trash py-3 fs-3 mx-auto"></i>
                        </button>
                    </div>
                    
                </div>

                <div class="card filter-card-mobile mb-4 bg-white border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title mb-3 text-muted small text-uppercase fw-bold"><i class="bi bi-funnel-fill me-2"></i>Filters</h5>
                        <div class="form-floating mb-3">
                            <input type="search" class="form-control" id="searchOrdersMobile" name="search" placeholder="Search order number..." value="<%= locals.query ? query.search : '' %>">
                            <label for="searchOrdersMobile">Search order number...</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control flatpickr-range" id="filter-date-range-mobile" name="dateRange" placeholder="Select date range" value="<%= locals.query ? query.dateRange : '' %>">
                            <label for="filter-date-range-mobile">Select date range</label>
                        </div>
                        <div class="form-floating mb-3">
                            <select name="status" id="status-filter-mobile" class="form-select">
                                <option value="">All Statuses</option>
                                <option value="Pending" <%= locals.query && query.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                                <option value="Ready" <%= locals.query && query.status === 'Ready' ? 'selected' : '' %>>Ready</option>
                                <option value="Completed" <%= locals.query && query.status === 'Completed' ? 'selected' : '' %>>Completed</option>
                                <option value="Cancelled" <%= locals.query && query.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                            </select>
                            <label for="status-filter-mobile">Status</label>
                        </div>
                        <div class="d-grid">
                            <button type="button" class="btn btn-light border" id="clear-filters-mobile">Clear Filters</button>
                        </div>
                    </div>
                </div>

                <div id="transaction-list-container-mobile">
                    <%- include('_ordersList', { transactions: transactions, target: 'mobile' }) %>
                </div>

            </main>
        </div>
    </div>
    <%- include('../partials/adminBottomNav', { activePage: 'orders' }) %>
</div>


<%# --- DESKTOP VIEW --- %>
<div class="admin-main-container d-none d-lg-block">
    <div class="admin-page-header mb-4">
        <div>
            <h2 class="h3 mb-0 fw-bold">Transactions</h2>
            <p class="text-muted"><span id="transaction-count-desktop"><%= transactions.length %></span> of <span id="total-branch-count-desktop"><%= totalTransactionsCount %></span> records shown</p>
        </div>
            <div class="">
