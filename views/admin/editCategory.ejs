<%- include('../partials/adminHeader') %>

<%- include('../partials/adminDesktopNav', { activePage: 'categories' }) %>

<div class="d-lg-none">

    <div class="admin-container">
        <div class="admin-content">
            <%- include('../partials/adminNavbar') %>

            <main class="p-3">
                <div class="page-header d-flex justify-content-between align-items-center mb-4">
                    <h2 class="h3">Edit Category</h2>
                    <a href="/admin/categories" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

                <div class="card form-card">
                    <div class="card-body">
                        <form action="/admin/categories/edit/<%= category_details._id %>" method="POST">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="nameMobile" name="name" placeholder="Category Name" value="<%= category_details.name %>" required>
                                <label for="nameMobile">Category Name</label>
                            </div>
                            
                            <button type="submit" class="btn btn-primary w-100 btn-lg">Save Changes</button>
                        </form>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <%- include('../partials/adminBottomNav', { activePage: 'categories' }) %>
</div>


<div class="admin-main-container d-none d-lg-block">
    <div class="admin-page-header">
        <div>
            <h2 class="h3 mb-0">Edit Category</h2>
            <p class="text-muted">Update the name for the <%= category_details.name %> category.</p>
        </div>
        <a href="/admin/categories" class="btn btn-outline-secondary d-flex align-items-center">
            <i class="bi bi-x-lg me-1"></i> Cancel
        </a>
    </div>

    <div class="card form-card">
        <div class="card-body p-4">
            <form action="/admin/categories/edit/<%= category_details._id %>" method="POST">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="nameDesktop" name="name" placeholder="Category Name" value="<%= category_details.name %>" required>
                    <label for="nameDesktop">Category Name</label>
                </div>
                
                <hr class="my-4">

                <div class="text-end">
                    <button type="submit" class="btn btn-primary btn-lg">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/adminFooter') %>