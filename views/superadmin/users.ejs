<%- include('../partials/superAdminHeader') %>
<%- include('../partials/superAdminNav', { activePage: 'users' }) %>

<%# --- MOBILE VIEW --- %>
<div class="d-lg-none">
    <main class="superadmin-main-container">
        <div class="page-header">
            <div>
                <h2 class="h3 mb-0">Users</h2>
                <p class="text-muted"><%= users.length %> registered users</p>
            </div>
            <a href="/superadmin/users/add" class="btn btn-primary fw-bold">
                <i class="bi bi-plus-lg me-1"></i> Add User
            </a>
        </div>

        <%# Mobile Filter Card (Optional - can add search/branch filter later if needed) %>
        <%# <div class="card filter-card-mobile mb-4"> ... </div> %>

        <div class="user-list-mobile">
            <% if (users && users.length > 0) { %>
                <% users.forEach(user => { %>
                    <div class="card user-card-revamp mb-3">
                        <div class="card-body">
                             <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <%# Updated: Display Full Name %>
                                    <h5 class="card-title mb-1"><%= user.firstName %> <%= user.lastName %></h5>
                                    <%# Updated: Display Contact Number %>
                                    <small class="text-muted d-block"><%= user.contactNumber %></small>
                                    <small class="text-muted d-block"><%= user.branch ? user.branch.name : 'N/A' %></small>
                                     <small class="text-muted d-block mt-1">
                                         <i class="bi bi-calendar-event"></i> Joined: <%= new Date(user.createdAt).toLocaleDateString() %>
                                     </small>
                                </div>
                                <%# Status Badge (Using Role) %>
                                <span class="badge badge-<%= user.role.toLowerCase().replace(' ', '-') %>">
                                    <%= user.role %>
                                </span>
                            </div>
                            <hr class="my-2">
                            <%# Action Buttons for Mobile %>
                            <div class="d-flex justify-content-end gap-2">
                                <a href="/superadmin/users/edit/<%= user._id %>" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                                <form action="/superadmin/users/delete/<%= user._id %>" method="POST" class="d-inline needs-confirmation" data-confirm-message="Are you sure you want to delete this user? This action cannot be undone.">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash3 me-1"></i>Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="card text-center py-5">
                    <i class="bi bi-people fs-1 text-muted mb-3"></i>
                    <h5 class="mb-1">No Users Found</h5>
                    <p class="text-muted">Get started by adding a user.</p>
                     <a href="/superadmin/users/add" class="btn btn-primary mt-2">
                          <i class="bi bi-plus-lg me-2"></i>Add User
                     </a>
                </div>
            <% } %>
        </div>
    </main>
    <%- include('../partials/superAdminBottomNav', { activePage: 'users' }) %>
</div>


<%# --- DESKTOP VIEW --- %>
<div class="superadmin-main-container d-none d-lg-block">
    <div class="admin-page-header"> <%# Reusing admin style %>
        <div>
            <h2 class="h3 mb-0">Users</h2>
            <p class="text-muted"><%= users.length %> registered users</p>
        </div>
        <a href="/superadmin/users/add" class="btn btn-primary fw-bold">
            <i class="bi bi-plus-lg me-1"></i> Add User
        </a>
    </div>

     <%# Desktop Filter Bar (Optional) %>
     <%# <div class="card filter-bar mb-4"> ... </div> %>

    <div class="list-table-container">
        <% if (users && users.length > 0) { %>
            <%# Updated: Adjusted grid columns and headers %>
            <div class="list-table-header" style="grid-template-columns: 2fr 1.5fr 1.5fr 1fr 1fr auto;">
                <span>Full Name</span>
                <span>Contact Number</span>
                <span>Branch</span>
                <span>Role</span>
                <span>Joined</span>
                <span class="text-end">Actions</span>
            </div>

            <div class="user-list-desktop">
                <% users.forEach(user => { %>
                    <%# Updated: Adjusted grid columns %>
                    <div class="list-table-row" style="grid-template-columns: 2fr 1.5fr 1.5fr 1fr 1fr auto;">
                        <%# Updated: Display Full Name %>
                        <div class="fw-bold"><%= user.firstName %> <%= user.lastName %></div>
                        <%# Updated: Display Contact Number %>
                        <div><%= user.contactNumber %></div>
                        <div><%= user.branch ? user.branch.name : 'N/A' %></div>
                        <div>
                           <span class="badge badge-<%= user.role.toLowerCase().replace(' ', '-') %>">
                                <%= user.role %>
                           </span>
                        </div>
                        <div class="text-muted"><%= new Date(user.createdAt).toLocaleDateString('en-CA') %></div>
                        <div class="text-end d-flex justify-content-end gap-2">
                             <a href="/superadmin/users/edit/<%= user._id %>" class="action-btn" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form action="/superadmin/users/delete/<%= user._id %>" method="POST" class="d-inline needs-confirmation" data-confirm-message="Are you sure you want to delete this user? This action cannot be undone.">
                                <button type="submit" class="action-btn text-danger bg-transparent border-0 p-0" title="Delete">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-5">
                <i class="bi bi-people fs-1 text-muted mb-3"></i>
                <h5 class="mb-1">No Users Found</h5>
                <p class="text-muted">Get started by adding a user.</p>
                 <a href="/superadmin/users/add" class="btn btn-primary mt-2">
                      <i class="bi bi-plus-lg me-2"></i>Add User
                 </a>
            </div>
        <% } %>
    </div>
</div>

<%# Add unique badge styles if not already present in style.css %>
<style>
    .badge-super-admin { background-color: #A2A2A2; color: white; } /* Example */
    .badge-assistant-manager { background-color: #6E6E6E; color: white; } /* Example */
    /* Add styles for front-liner, cook, admin if needed and not covered by existing ones */
    .badge-front-liner { background-color: var(--frontliner-bg); color: var(--frontliner-text); }
    .badge-cook { background-color: var(--cook-bg); color: var(--cook-text); }
    .badge-admin { background-color: var(--admin-bg); color: var(--admin-text); }
</style>

<%- include('../partials/superAdminFooter') %>

<%# Confirmation Script (if not already global) %>
<script>
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.needs-confirmation').forEach(form => {
        form.addEventListener('submit', function(event) {
            const message = this.dataset.confirmMessage || 'Are you sure?';
            if (!confirm(message)) { event.preventDefault(); }
        });
    });
     // Add search/filter JS here if filters were added
});
</script>