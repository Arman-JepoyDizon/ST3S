<%- include('../partials/superAdminHeader') %>
<%- include('../partials/superAdminNav', { activePage: 'products' }) %>

<main class="superadmin-main-container">
    <div class="page-header">
        <div>
            <h2 class="h3 mb-0">Edit Product</h2>
            <p class="text-muted">Update details for <%= product.name %>.</p>
        </div>
        <a href="/superadmin/products" class="btn btn-outline-secondary d-flex align-items-center">
            <i class="bi bi-x-lg me-1"></i> Cancel
        </a>
    </div>

    <div class="card form-card" style="max-width: 900px; margin: 0 auto;">
        <div class="card-body p-lg-4">
            <form action="/superadmin/products/update/<%= product._id %>" method="POST">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" id="name" name="name" placeholder="Product Name" value="<%= product.name %>" required>
                            <label for="name">Product Name</label>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-floating mb-3">
                            <select name="category" id="category" class="form-select" required>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat._id %>" <%= String(cat._id) === String(product.category) ? 'selected' : '' %>><%= cat.name %></option>
                                <% }) %>
                            </select>
                            <label for="category">Category</label>
                        </div>
                    </div>
                </div>
                <div class="form-floating mb-4">
                    <input type="text" class="form-control" id="imageUrl" name="imageUrl" placeholder="Image URL (Optional)" value="<%= product.imageUrl || '' %>">
                    <label for="imageUrl">Image URL (Optional)</label>
                </div>

                <hr>

                <div class="mb-4">
                    <h5 class="mb-3">Assign to Branches</h5>
                    <div class="branch-checkbox-grid">
                        <% branches.forEach(branch => { %>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" name="branches" id="branch-<%= branch._id %>" value="<%= branch._id %>" <%= product.branches.map(String).includes(String(branch._id)) ? 'checked' : '' %>>
                                <label class="form-check-label" for="branch-<%= branch._id %>"><%= branch.name %></label>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <hr>

                <div class="d-flex justify-content-between align-items-center my-3">
                    <h5 class="mb-0">Pricing & Variants</h5>
                </div>
                <p class="text-muted small">Variant and multi-price editing is handled by the Branch Admin. You can set the base price here.</p>
                <div class="form-floating mb-3">
                    <input type="number" class="form-control" name="price[]" step="0.01" min="0" placeholder="Base Price" value="<%= product.price %>" required>
                    <label>Base Price</label>
                </div>
                
                <hr class="mt-4">

                <div class="text-end">
                    <button type="submit" class="btn btn-primary btn-lg">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</main>

<div class="d-lg-none">
    <%- include('../partials/superAdminBottomNav', { activePage: 'products' }) %>
</div>

<%- include('../partials/superAdminFooter') %>