<%- include('../partials/superAdminHeader') %>
<%- include('../partials/superAdminNav', { activePage: 'users' }) %>

<main class="superadmin-main-container">
    <div class="page-header">
        <div>
            <h2 class="h3 mb-0">Edit User</h2>
            <p class="text-muted">Update details for <%= userToEdit.username %>.</p>
        </div>
        <a href="/superadmin/users" class="btn btn-outline-secondary d-flex align-items-center">
            <i class="bi bi-x-lg me-1"></i> Cancel
        </a>
    </div>

    <div class="card form-card" style="max-width: 800px; margin: 0 auto;">
        <div class="card-body p-lg-4">
            <form action="/superadmin/users/edit/<%= userToEdit._id %>" method="POST">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" id="username" name="username" placeholder="Username" value="<%= userToEdit.username %>" required>
                            <label for="username">Username</label>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-floating mb-3">
                             <select class="form-select" id="role" name="role">
                                <option value="Admin" <%= userToEdit.role === 'Admin' ? 'selected' : '' %>>Admin</option>
                                <option value="Front Liner" <%= userToEdit.role === 'Front Liner' ? 'selected' : '' %>>Front Liner</option>
                                <option value="Cook" <%= userToEdit.role === 'Cook' ? 'selected' : '' %>>Cook</option>
                                <option value="Super Admin" <%= userToEdit.role === 'Super Admin' ? 'selected' : '' %>>Super Admin</option>
                            </select>
                            <label for="role">Role</label>
                        </div>
                    </div>
                </div>

                <div class="form-floating mb-3" id="branch-selector-wrapper">
                    <select class="form-select" id="branch" name="branch">
                        <option value="">-- No Branch Assigned --</option>
                        <% branches.forEach(branch => { %>
                            <option value="<%= branch._id %>" <%= userToEdit.branch && String(userToEdit.branch) === String(branch._id) ? 'selected' : '' %>><%= branch.name %></option>
                        <% }) %>
                    </select>
                    <label for="branch">Branch</label>
                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-between align-items-center">
                     <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteUserModal">Delete User</button>
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-check-circle-fill me-2"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>

<div class="modal fade" id="deleteUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the user <strong><%= userToEdit.username %></strong>? This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form action="/superadmin/users/delete/<%= userToEdit._id %>" method="POST">
                    <button type="submit" class="btn btn-danger">Yes, Delete User</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="d-lg-none">
    <%- include('../partials/superAdminBottomNav', { activePage: 'users' }) %>
</div>

<%- include('../partials/superAdminFooter') %>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const roleSelector = document.getElementById('role');
        const branchWrapper = document.getElementById('branch-selector-wrapper');

        const toggleBranchSelector = () => {
            if (roleSelector.value === 'Super Admin') {
                branchWrapper.style.display = 'none';
                branchWrapper.querySelector('select').removeAttribute('required');
            } else {
                branchWrapper.style.display = 'block';
                branchWrapper.querySelector('select').setAttribute('required', 'required');
            }
        };

        roleSelector.addEventListener('change', toggleBranchSelector);
        toggleBranchSelector(); // Run on page load
    });
</script>