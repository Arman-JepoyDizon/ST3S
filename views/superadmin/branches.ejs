<%- include('../partials/superAdminHeader') %>
<%- include('../partials/superAdminNav', { activePage: 'branches' }) %>

<%# --- MOBILE VIEW --- %>
<div class="d-lg-none">
    <main class="superadmin-main-container">
        <div class="page-header">
            <div>
                <h2 class="h3 mb-0">Branches</h2>
                <p class="text-muted"><%= branches.length %> active branches</p>
            </div>
            <a href="/superadmin/branches/add" class="btn btn-primary fw-bold">
                <i class="bi bi-plus-lg me-1"></i> Add Branch
            </a>
        </div>

        <div class="user-list-mobile">
            <% if (branches && branches.length > 0) { %>
                <% branches.forEach(branch => { %>
                    <div class="card user-card-revamp mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h5 class="card-title mb-1"><%= branch.name %></h5>
                                    <small class="text-muted d-block"><%= branch.location %></small>
                                    <small class="text-muted d-block"><%= branch.contact || 'N/A' %></small>
                                </div>
                                <% if (branch.status === 'Active') { %>
                                    <span class="badge badge-status-completed">Active</span>
                                <% } else { %>
                                    <span class="badge badge-status-cancelled">Inactive</span>
                                <% } %>
                            </div>
                            <hr class="my-2">
                            <div class="d-flex justify-content-end gap-2">
                                <a href="/superadmin/branches/edit/<%= branch._id %>" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form action="/superadmin/branches/delete/<%= branch._id %>" method="POST" onsubmit="return confirm('Are you sure?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="card text-center py-5">
                    <p class="text-muted">No branches found.</p>
                </div>
            <% } %>
        </div>
    </main>
    <%- include('../partials/superAdminBottomNav', { activePage: 'branches' }) %>
</div>


<%# --- DESKTOP VIEW --- %>
<div class="d-none d-lg-block">
    <main class="superadmin-main-container">
        <div class="page-header">
            <div>
                <h2 class="h3 mb-0">Branches</h2>
                <p class="text-muted"><%= branches.length %> active branches</p>
            </div>
            <a href="/superadmin/branches/add" class="btn btn-primary fw-bold">
                <i class="bi bi-plus-lg me-1"></i> Add Branch
            </a>
        </div>

        <% if (branches && branches.length > 0) { %>
            <div class="list-table-container">
                <div class="list-table-header branches-grid">
                    <span>Branch Name</span>
                    <span>Location</span>
                    <span>Contact</span>
                    <span>Status</span>
                    <span class="text-end">Actions</span>
                </div>

                <div class="branch-list">
                    <% branches.forEach(branch => { %>
                        <div class="list-table-row branches-grid">
                            <div class="fw-bold"><%= branch.name %></div>
                            <div><%= branch.location %></div>
                            <div class="text-muted"><%= branch.contact || 'N/A' %></div>
                            <div>
                                <% if (branch.status === 'Active') { %>
                                    <span class="badge badge-status-completed">Active</span>
                                <% } else { %>
                                    <span class="badge badge-status-cancelled">Inactive</span>
                                <% } %>
                            </div>
                            <div class="text-end d-flex justify-content-end gap-3">
                                <a href="/superadmin/branches/edit/<%= branch._id %>" class="action-btn" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form action="/superadmin/branches/delete/<%= branch._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this branch? This action cannot be undone.');" class="d-inline">
                                    <button type="submit" class="action-btn text-danger bg-transparent border-0 p-0" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } else { %>
            <div class="card text-center py-5">
                 <div class="card-body">
                    <h5 class="card-title">No Branches Found</h5>
                    <p class="text-muted">Get started by adding your first branch location.</p>
                    <a href="/superadmin/branches/add" class="btn btn-primary mt-2">
                         <i class="bi bi-plus-lg me-2"></i>Add a Branch
                    </a>
                </div>
            </div>
        <% } %>
    </main>
</div>

<%- include('../partials/superAdminFooter') %>