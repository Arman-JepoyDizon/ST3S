<%- include('../partials/cookHeader') %>

<div class="d-lg-none">
    <main class="cook-main-content">
        <div class="card cook-summary-card mb-4">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <div class="summary-icon-wrapper me-3">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0 fw-bold">Active Orders</h5>
                        <p class="card-text text-muted mb-0"><%= orders.length %> pending</p>
                    </div>
                </div>
                <a href="/cook/dashboard" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-clockwise"></i>
                </a>
            </div>
        </div>
    
        <% if (orders && orders.length > 0) { %>
            <% orders.forEach(order => { %>
                <div class="card order-card-cook mb-4" data-created-at="<%= order.createdAt.toISOString() %>">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold mb-0">
                                #<%= order._id.toString().slice(-4).toUpperCase() %>
                                <small class="text-muted fw-normal ms-2 order-timer">(00:00)</small>
                            </h5>
                            <small class="text-muted"><%= order.customerName ? order.customerName : 'Walk-in Customer' %></small>
                        </div>
                        <span class="badge badge-urgent d-none">URGENT</span>
                    </div>
                    <div class="card-body">
                        <% order.items.forEach(item => { %>
                            <div class="card order-item-card-cook mb-2">
                                <div class="card-body d-flex align-items-center">
                                    <span class="item-quantity"><%= item.quantity %>x</span>
                                    <div>
                                        <p class="item-name mb-0"><%= item.productId ? item.productId.name : 'Product not found' %></p>
                                        <% if (item.sizeLabel) { %><small class="text-muted"><%= item.sizeLabel %></small><% } %>
                                        <% if (item.notes) { %><small class="d-block text-danger fst-italic">Note: <%= item.notes %></small><% } %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                    <div class="card-footer">
                        <form action="/cook/orders/<%= order._id %>/ready" method="POST">
                            <button type="submit" class="btn btn-success btn-ready w-100 btn-lg">
                                <i class="bi bi-check-circle-fill me-2"></i>Ready for Pickup
                            </button>
                        </form>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="card text-center py-5">
                <div class="card-body">
                    <div class="empty-cart-icon mb-3"><i class="bi bi-cup-hot"></i></div>
                    <h4 class="text-muted">Waiting for new orders!</h4>
                    <p class="text-muted">No pending orders in the queue.</p>
                </div>
            </div>
        <% } %>
    </main>
</div>


<div class="cook-desktop-container d-none d-lg-block">
    <div class="cook-page-header">
        <div class="d-flex align-items-center">
            <div class="summary-icon-wrapper me-3">
                <i class="bi bi-clock-history"></i>
            </div>
            <div>
                <h2 class="h3 mb-0 fw-bold">Active Orders</h2>
                <p class="text-muted mb-0"><%= orders.length %> orders in queue</p>
            </div>
        </div>
        <a href="/cook/dashboard" class="btn btn-primary fw-bold">
            <i class="bi bi-arrow-clockwise me-2"></i>Refresh
        </a>
    </div>

    <% if (orders && orders.length > 0) { %>
        <div class="row">
            <% orders.forEach(order => { %>
                <div class="col-lg-4">
                    <div class="card order-card-desktop" data-created-at="<%= order.createdAt.toISOString() %>">
                        <div class="card-header">
                            <div class="d-flex justify-content-between align-items-center">
                                <h4 class="fw-bold mb-0">#<%= order._id.toString().slice(-4).toUpperCase() %></h4>
                                <span class="badge badge-urgent d-none">URGENT</span>
                            </div>
                            <p class="text-muted mb-0"><%= order.customerName ? order.customerName : 'Walk-in Customer' %></p>
                            <small class="text-muted order-timer">00:00</small>
                        </div>
                        <div class="card-body">
                            <% order.items.forEach(item => { %>
                                <div class="order-item-desktop">
                                    <span class="item-quantity"><%= item.quantity %>x</span>
                                    <div>
                                        <p class="item-name mb-0"><%= item.productId ? item.productId.name : 'Product not found' %></p>
                                        <% if (item.sizeLabel) { %><small class="text-muted"><%= item.sizeLabel %></small><% } %>
                                        <% if (item.notes) { %><small class="d-block text-danger fst-italic">Note: <%= item.notes %></small><% } %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                        <div class="card-footer">
                            <form action="/cook/orders/<%= order._id %>/ready" method="POST">
                                <button type="submit" class="btn btn-success btn-ready w-100 btn-lg">
                                    <i class="bi bi-check-circle-fill me-2"></i>Ready for Pickup
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
         <div class="card text-center py-5" style="border: none; background: transparent;">
            <div class="card-body">
                <div class="empty-cart-icon mb-3" style="font-size: 5rem;"><i class="bi bi-cup-hot"></i></div>
                <h2 class="text-muted">Waiting for new orders!</h2>
                <p class="text-muted fs-5">No pending orders in the queue.</p>
            </div>
        </div>
    <% } %>
</div>

<%- include('../partials/cookFooter') %>